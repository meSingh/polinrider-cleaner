---
// Every page: the <head> (title, description, canonical address, social
// card, News feed, search engine verification and, once switched on,
// Cloudflare Web Analytics), the top bar, the page and the footer. The tags match what the
// site carried under Starlight, so search results and shared links look the
// same after the move.
import '../styles/theme.css';
import '../styles/base.css';
import '../styles/prose.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeScript from '../components/ThemeScript.astro';
import geist from '../assets/fonts/geist-variable.woff2?url';
import { jsonLd, person, website } from '../schema';
import {
  BING_SITE_VERIFICATION,
  GOOGLE_SITE_VERIFICATION,
  ANALYTICS_ON,
  CF_WEB_ANALYTICS_TOKEN,
  SHORT_TITLE,
  SITE_DESCRIPTION,
  SITE_ORIGIN,
  SITE_TITLE,
  SITE_URL,
  SOCIAL_IMAGE,
} from '../siteConfig.mjs';

interface Props {
  title: string;
  description?: string;
  /** "article" for a page of writing, "website" for the home page and lists. */
  type?: 'article' | 'website';
  /** Where the canonical copy of this page lives, when it is not here. */
  canonical?: string;
  noindex?: boolean;
  /** false on a page with no address of its own, such as the 404. */
  hasCanonical?: boolean;
  /** The <title>, when it should differ from the page's heading. */
  titleTag?: string;
  /** This page's own social image (src/og.ts); the site's default if unset. */
  image?: { url: string; width: number; height: number; alt: string };
  /** The page sits in the wider .frame (a sidebar layout): the top bar
   * matches it. */
  frame?: boolean;
  /** Structured data for this page (src/schema.ts). The site's author and
   * the site itself are added, so every @id a node names is on the page. */
  schema?: Record<string, unknown>[];
}
const {
  title,
  description = SITE_DESCRIPTION,
  type = 'article',
  canonical,
  noindex = false,
  hasCanonical = true,
  titleTag,
  schema = [],
  frame = false,
  image = SOCIAL_IMAGE,
} = Astro.props;
const graph = schema.length ? [...schema, website, person] : [];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = canonical ?? new URL(Astro.url.pathname, SITE_ORIGIN).href;
// "<page> | PolinRider Scanner" while that fits the 60 or so characters a
// search result shows; a longer page title stands alone rather than be cut.
const branded = `${title} | ${SHORT_TITLE}`;
const fullTitle = titleTag ?? (branded.length <= 60 ? branded : title);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <link rel="preload" href={geist} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    {hasCanonical && <link rel="canonical" href={url} />}
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE}: News`} href={`${SITE_URL}/news/rss.xml`} />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:title" content={title} />
    <meta property="og:type" content={type} />
    {hasCanonical && <meta property="og:url" content={url} />}
    <meta property="og:locale" content="en" />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:image" content={image.url} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image.url} />
    <meta name="twitter:image:alt" content={image.alt} />

    {GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}
    {BING_SITE_VERIFICATION && <meta name="msvalidate.01" content={BING_SITE_VERIFICATION} />}
    {ANALYTICS_ON && (
      <script
        is:inline
        type="module"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: CF_WEB_ANALYTICS_TOKEN })}
      />
    )}
    <ThemeScript />
    {graph.length > 0 && <script type="application/ld+json" is:inline set:html={jsonLd(graph)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header frame={frame} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/copy.ts';
    </script>
  </body>
</html>
