---
// One update or one weekly indicator review, as a plain article: its label,
// title, date and reading time, the text, its Sources (part of the text)
// and at most one related link. On a wide screen a rail fills the space to
// the right without widening the text: "On this page", a small "Check your
// computer" box and two related pieces. Structured data stays in the
// page's metadata only.
//
// Older articles carry a "Check yours" box and, in one case, a questions
// section in their Markdown. Neither is shown here: the box is cut from the
// rendered text and the questions component draws nothing inside an
// article (Astro.locals.plainArticle), so the files need no edit.
import Base from './Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Toc from '../components/Toc.astro';
import Rail from '../components/Rail.astro';
import RailCheck from '../components/RailCheck.astro';
import RailRelated, { type RailItem } from '../components/RailRelated.astro';
import type { MarkdownHeading } from 'astro';
import { abs, article, breadcrumbs } from '../schema';
import { lastUpdated } from '../git';
import { longDate } from '../releaseDate';
import { plainArticle } from '../updates-article';

interface Props {
  kind: 'update' | 'review';
  /** The label above the title: the article's category, or "Indicator review". */
  label: string;
  /** The crumb between Home and the page: its category or the reviews. */
  crumb: { label: string; href: string };
  title: string;
  description?: string;
  date: string;
  minutes?: number;
  file?: string;
  citations?: string[];
  image?: { url: string; width: number; height: number; alt: string };
  related?: { label: string; href: string };
  /** The article's headings, for "On this page" in the rail. */
  headings?: MarkdownHeading[];
  /** Two related pieces for the rail. */
  more?: RailItem[];
}
const { kind, label, crumb, title, description, date, minutes, file, citations, image, related, headings = [], more = [] } = Astro.props;
const crumbs = [crumb];
const url = abs(Astro.url.pathname);
const schema = [
  breadcrumbs(crumbs, title, url),
  article({
    type: kind === 'update' ? 'NewsArticle' : 'TechArticle',
    url,
    title,
    description,
    published: date,
    modified: file ? lastUpdated(file) : undefined,
    citations,
    section: crumb.label,
    image: image?.url,
  }),
];
(Astro.locals as { plainArticle?: boolean }).plainArticle = true;
const body = plainArticle(await Astro.slots.render('default'));
// Only headings still in the text: the cut parts take theirs with them.
const shown = headings.filter((h) => body.includes(`id="${h.slug}"`));
---

<Base title={title} description={description} schema={schema} image={image}>
  <div class="wrap reading">
  <article class="update" data-pagefind-body data-pagefind-meta={`section:${crumb.label}`}>
    <Crumbs items={crumbs} />
    <p class="kicker">{label}</p>
    <h1 data-pagefind-meta="title">{title}</h1>
    <p class="meta">
      <time datetime={date}>{longDate(date)}</time>
      {minutes && <> · {minutes} min read</>}
    </p>
    <div class="prose" set:html={body} />
    {
      related && (
        <p class="related no-print">
          Related: <a href={related.href}>{related.label}</a>
        </p>
      )
    }
  </article>
  <Rail on="article">
    <Toc headings={shown} />
    <RailCheck />
    <RailRelated items={more} />
  </Rail>
  </div>
</Base>

<style>
  .reading {
    padding-block: 2.5rem 4rem;
  }
  /* Wide: the article keeps its 46rem column at the left, the rail sits at
   * the right edge of the page width. */
  @media (min-width: 72rem) {
    .reading {
      display: grid;
      grid-template-columns: minmax(0, 46rem) 16rem;
      justify-content: space-between;
      column-gap: 4rem;
    }
  }
  .update > :global(*) {
    max-width: 46rem;
  }
  .kicker {
    margin: 1.25rem 0 0;
    color: var(--pr-accent);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0.4rem 0 0;
    font-size: var(--text-h1);
    letter-spacing: -0.025em;
    line-height: 1.12;
  }
  .meta {
    margin: 0.75rem 0 2rem;
    color: var(--pr-muted);
    font-size: var(--text-sm);
  }
  .related {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--pr-border);
    color: var(--pr-muted);
  }
</style>
