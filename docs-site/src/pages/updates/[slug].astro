---
// One of our updates (content/news), as a plain article. Its one related
// link is the weekly review it came from, when it came from one.
import { getCollection, render } from 'astro:content';
import Update from '../../layouts/Update.astro';
import { readingMinutes } from '../../news';
import { longDate } from '../../releaseDate';
import { citations } from '../../schema';
import { ogImage } from '../../og';

export async function getStaticPaths() {
  return (await getCollection('news')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { title, description, date, review } = entry.data;
---

<Update
  kind="update"
  title={title}
  description={description}
  date={date}
  minutes={readingMinutes(entry.body)}
  file={entry.filePath}
  citations={citations(entry.body)}
  image={ogImage(`updates/${entry.id}`, `${title}. ${description}`)}
  related={review ? { label: `Indicator review, ${longDate(review)}`, href: `${base}/updates/indicator-reviews/${review}/` } : undefined}
>
  <Content />
</Update>
