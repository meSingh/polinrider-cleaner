---
// Updates: what's happening with PolinRider, newest first. "Where things
// stand" at the top (content/status.md), then one line of time: our
// articles, articles published elsewhere and the weekly indicator reviews
// (one line each). The tabs filter by category; without JavaScript every
// entry shows. On a wide screen the filters, the RSS link and a small
// "Check your computer" box sit in a rail at the right; below that width
// the filters stay above the list, so they work on phones too.
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Icon from '../../components/Icon.astro';
import Rail from '../../components/Rail.astro';
import RailCheck from '../../components/RailCheck.astro';
import UpdatesTimeline from '../../components/UpdatesTimeline.astro';
import { timeline } from '../../news';
import { categories } from '../../categories.mjs';
import { longDate } from '../../releaseDate';
import { abs, breadcrumbs } from '../../schema';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const items = await timeline();
const status = (await getEntry('status', 'status'))!;
const { Content: Status } = await render(status);
// A tab for every category in use, in the order of src/categories.mjs,
// then the indicator reviews.
const used = new Set(items.map((i) => i.category));
const tabs = [
  ['all', 'All'],
  ...categories.filter((c) => used.has(c.slug)).map((c) => [c.slug, c.title]),
  ['indicator-reviews', 'Indicator reviews'],
];
---

<Base
  title="PolinRider updates"
  description="What's happening with PolinRider: our own updates, articles worth reading from other researchers and the weekly indicator reviews."
  type="website"
  schema={[breadcrumbs([], 'Updates', abs(Astro.url.pathname))]}
>
  <div class="wrap page">
    <div class="main">
    <Crumbs items={[]} />
    <div class="head">
      <div>
        <h1>PolinRider updates</h1>
        <p class="lead">What's happening with PolinRider.</p>
      </div>
      <a class="rss" href={`${base}/updates/rss.xml`}><Icon name="rss" size={17} /> RSS</a>
    </div>

    <section class="status" aria-labelledby="status-h">
      <h2 id="status-h">Where things stand</h2>
      <div class="status-body"><Status /></div>
      <p class="status-date">
        Updated <time datetime={status.data.updated}>{longDate(status.data.updated)}</time>
        {status.data.sources && <> · Sources: {status.data.sources}</>}
      </p>
    </section>

    <div class="tabs no-print needs-js" role="group" aria-label="Show">
      {tabs.map(([kind, label], i) => (
        <button type="button" data-filter={kind} aria-pressed={i === 0 ? 'true' : 'false'}>{label}</button>
      ))}
    </div>

    <UpdatesTimeline items={items} months />
    </div>
    <Rail on="updates">
      <nav class="filters needs-js" aria-labelledby="filters-h">
        <p class="rail-title" id="filters-h">Show</p>
        <ul>
          {tabs.map(([kind, label], i) => (
            <li><button type="button" data-filter={kind} aria-pressed={i === 0 ? 'true' : 'false'}>{label}</button></li>
          ))}
        </ul>
      </nav>
      <div>
        <p class="rail-title">Follow updates</p>
        <a class="feed" href={`${base}/updates/rss.xml`}><Icon name="rss" size={16} /> Subscribe with RSS</a>
      </div>
      <RailCheck />
    </Rail>
  </div>
</Base>

<script>
  // Filter by kind. A month with nothing left in it hides too.
  // The tabs above the list and the filters in the rail are the same
  // control at two widths; both stay in step.
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('button[data-filter]')];
  const show = (kind: string) => {
    for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.filter === kind));
    for (const li of document.querySelectorAll<HTMLElement>('.updates-timeline .item'))
      li.hidden = kind !== 'all' && li.dataset.category !== kind;
    for (const g of document.querySelectorAll<HTMLElement>('.updates-timeline .group'))
      g.hidden = !g.querySelector('.item:not([hidden])');
  };
  for (const b of buttons) b.addEventListener('click', () => show(b.dataset.filter!));
</script>

<style>
  /* The same width as the top bar, so the title lines up under the logo;
   * the reading column keeps its measure from the left edge. */
  .page {
    padding-block: 2.5rem 4rem;
  }
  .main > :global(*) {
    max-width: 52rem;
  }
  /* Wide: the list keeps its 52rem column, the rail sits at the right edge
   * of the page width, and the filters and RSS move into it. */
  @media (min-width: 76rem) {
    .page {
      display: grid;
      grid-template-columns: minmax(0, 52rem) 16rem;
      justify-content: space-between;
      column-gap: 3.5rem;
    }
    .main .tabs,
    .head .rss {
      display: none;
    }
    .main > :global(.updates-timeline) {
      margin-top: 1.75rem;
    }
  }
  .filters ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-inline-start: 1px solid var(--pr-border);
  }
  .filters button {
    display: block;
    width: 100%;
    margin-inline-start: -1px;
    padding: 0.22rem 0 0.22rem 0.9rem;
    border: 0;
    border-inline-start: 2px solid transparent;
    background: none;
    color: var(--pr-muted);
    font: inherit;
    line-height: 1.4;
    text-align: start;
    cursor: pointer;
  }
  .filters button:hover {
    color: var(--pr-heading);
  }
  .filters button[aria-pressed='true'] {
    border-color: var(--pr-heading);
    color: var(--pr-heading);
    font-weight: 600;
  }
  .feed {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--pr-text);
    font-weight: 600;
    text-decoration: none;
  }
  .feed:hover {
    color: var(--pr-heading);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }
  h1 {
    margin: 0.75rem 0 0;
    font-size: var(--text-h1);
    letter-spacing: -0.025em;
  }
  .lead {
    margin: 0.5rem 0 0;
    color: var(--pr-text);
    font-size: 1.125rem;
  }
  .rss {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--pr-text);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .rss:hover {
    color: var(--pr-heading);
  }
  .status {
    margin-top: 1.75rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--pr-border);
    border-inline-start: 4px solid var(--pr-accent);
    border-radius: var(--pr-radius);
    background: var(--pr-surface);
  }
  .status h2 {
    margin: 0;
    font-size: 1.0625rem;
  }
  .status-body :global(p) {
    margin: 0.45rem 0 0;
    color: var(--pr-text);
    line-height: 1.6;
  }
  .status-date {
    margin: 0.6rem 0 0;
    color: var(--pr-muted);
    font-size: var(--text-sm);
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.75rem;
  }
  .tabs button {
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--pr-border);
    border-radius: 999px;
    background: var(--pr-bg);
    color: var(--pr-text);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .tabs button:hover {
    border-color: var(--pr-border-strong);
  }
  .tabs button[aria-pressed='true'] {
    border-color: var(--pr-heading);
    background: var(--pr-heading);
    color: var(--pr-bg);
  }
</style>
