---
// Updates: what's happening with PolinRider, newest first. "Where things
// stand" at the top (content/status.md), then one line of time in three
// kinds: our articles, the weekly indicator reviews (one line each) and
// articles worth reading elsewhere. The tabs filter by kind; without
// JavaScript every entry shows.
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Icon from '../../components/Icon.astro';
import UpdatesTimeline from '../../components/UpdatesTimeline.astro';
import { timeline } from '../../news';
import { longDate } from '../../releaseDate';
import { abs, breadcrumbs } from '../../schema';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const items = await timeline();
const status = (await getEntry('status', 'status'))!;
const { Content: Status } = await render(status);
const tabs = [
  ['all', 'All'],
  ['update', 'Our updates'],
  ['reading', 'Worth reading'],
  ['review', 'Indicator reviews'],
] as const;
---

<Base
  title="PolinRider updates"
  description="What's happening with PolinRider, newest first: our own updates, articles worth reading from other researchers and the weekly indicator reviews."
  type="website"
  schema={[breadcrumbs([], 'Updates', abs(Astro.url.pathname))]}
>
  <div class="wrap page">
    <Crumbs items={[]} />
    <div class="head">
      <div>
        <h1>PolinRider updates</h1>
        <p class="lead">What's happening with PolinRider, newest first.</p>
      </div>
      <a class="rss" href={`${base}/updates/rss.xml`}><Icon name="rss" size={17} /> RSS</a>
    </div>

    <section class="status" aria-labelledby="status-h">
      <h2 id="status-h">Where things stand</h2>
      <div class="status-body"><Status /></div>
      <p class="status-date">
        Updated <time datetime={status.data.updated}>{longDate(status.data.updated)}</time>
        {status.data.sources && <> · Sources: {status.data.sources}</>}
      </p>
    </section>

    <div class="tabs no-print" role="group" aria-label="Show">
      {tabs.map(([kind, label], i) => (
        <button type="button" data-filter={kind} aria-pressed={i === 0 ? 'true' : 'false'}>{label}</button>
      ))}
    </div>

    <UpdatesTimeline items={items} months />
  </div>
</Base>

<script>
  // Filter by kind. A month with nothing left in it hides too.
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.tabs button')];
  const show = (kind: string) => {
    for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.filter === kind));
    for (const li of document.querySelectorAll<HTMLElement>('.updates-timeline .item'))
      li.hidden = kind !== 'all' && li.dataset.kind !== kind;
    for (const g of document.querySelectorAll<HTMLElement>('.updates-timeline .group'))
      g.hidden = !g.querySelector('.item:not([hidden])');
  };
  for (const b of buttons) b.addEventListener('click', () => show(b.dataset.filter!));
</script>

<style>
  /* The same width as the top bar, so the title lines up under the logo;
   * the reading column keeps its measure from the left edge. */
  .page {
    padding-block: 2.5rem 4rem;
  }
  .page > :global(*) {
    max-width: 52rem;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }
  h1 {
    margin: 0.75rem 0 0;
    font-size: var(--text-h1);
    letter-spacing: -0.025em;
  }
  .lead {
    margin: 0.5rem 0 0;
    color: var(--pr-text);
    font-size: 1.125rem;
  }
  .rss {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--pr-text);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .rss:hover {
    color: var(--pr-heading);
  }
  .status {
    margin-top: 1.75rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--pr-border);
    border-inline-start: 4px solid var(--pr-accent);
    border-radius: var(--pr-radius);
    background: var(--pr-surface);
  }
  .status h2 {
    margin: 0;
    font-size: 1.0625rem;
  }
  .status-body :global(p) {
    margin: 0.45rem 0 0;
    color: var(--pr-text);
    line-height: 1.6;
  }
  .status-date {
    margin: 0.6rem 0 0;
    color: var(--pr-muted);
    font-size: var(--text-sm);
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.75rem;
  }
  .tabs button {
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--pr-border);
    border-radius: 999px;
    background: var(--pr-bg);
    color: var(--pr-text);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .tabs button:hover {
    border-color: var(--pr-border-strong);
  }
  .tabs button[aria-pressed='true'] {
    border-color: var(--pr-heading);
    background: var(--pr-heading);
    color: var(--pr-bg);
  }
</style>
