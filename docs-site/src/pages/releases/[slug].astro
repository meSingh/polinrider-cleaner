---
// One release: its date (from the signed tag, src/releaseDate.ts), then New,
// Changed, Breaking changes and, last, Download: read what changed first.
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { releases } from '../../releases';
import { abs, release } from '../../schema';

export async function getStaticPaths() {
  return (await getCollection('releases')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = await releases();
const self = all.find((r) => r.id === entry.id)!;
---

<Article
  title={entry.data.title}
  description={entry.data.description}
  crumbs={[{ label: 'Releases', href: `${base}/releases/` }]}
  headings={headings}
  section="Releases"
  file={entry.filePath}
  foot={false}
  schemaType="none"
  extraSchema={[release({ version: self.version, date: self.date, description: self.description, url: abs(Astro.url.pathname) })]}
  side={{
    title: 'Releases',
    items: [
      { label: 'All releases', href: `${base}/releases/` },
      ...all.map((r, i) => ({ label: r.version, href: r.href, badge: i === 0 ? 'latest' : undefined })),
    ],
  }}
>
  <Content />
</Article>
