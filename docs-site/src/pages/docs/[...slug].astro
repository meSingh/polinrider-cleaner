---
// Every documentation page, for the latest release at /docs/ and for each
// frozen copy at /docs/X.Y/, plus an overview at the top of each.
import { render } from 'astro:content';
import Docs from '../../layouts/Docs.astro';
import DocsOverview from '../../components/DocsOverview.astro';
import { builtVersions, navFor, pagesOf, type DocsEntry, type DocsVersion } from '../../docs';
import { SITE_URL } from '../../siteConfig.mjs';
import { abs, howTo } from '../../schema';

export async function getStaticPaths() {
  const versions = await builtVersions();
  const paths = [];
  for (const version of versions) {
    const pages = await pagesOf(version.key);
    const latestPages = await pagesOf('');
    const nav = navFor(version, pages);
    const prefix = version.key ? `${version.key}/` : '';
    paths.push({ params: { slug: version.key || undefined }, props: { version, versions, nav, id: '', entry: undefined, canonical: undefined } });
    for (const [id, entry] of pages) {
      const canonical = version.latest || !latestPages.has(id) ? undefined : `${SITE_URL}/docs/${id}/`;
      paths.push({ params: { slug: `${prefix}${id}` }, props: { version, versions, nav, id, entry, canonical } });
    }
  }
  return paths;
}

interface Props {
  version: DocsVersion;
  versions: DocsVersion[];
  nav: ReturnType<typeof navFor>;
  id: string;
  entry?: DocsEntry;
  canonical?: string;
}
const { version, versions, nav, id, entry, canonical } = Astro.props;
const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;

// The quick start's steps as HowTo data. They restate the page's own steps
// (content/docs/quick-start.mdx), so change both together.
const quickStartSteps = [
  {
    name: 'Download it',
    text: 'Download the archive for your computer from the latest release on GitHub: macOS (Apple silicon or Intel), Linux (x86_64 or arm64) or Windows (x86_64). Or install it with Homebrew or Scoop.',
  },
  {
    name: 'Check that it is genuine',
    text: 'Run sha256sum -c SHA256SUMS --ignore-missing, then gh attestation verify on the archive with --repo meSingh/polinrider-scanner.',
  },
  {
    name: 'Unpack it and run it',
    text: 'Unpack the archive and run ./polinrider with no arguments. Keep the ioc/ folder beside the program: it is the indicator set.',
  },
  {
    name: 'Answer the first question',
    text: 'It asks what to check. Answer with a word: computer, folder, account, organization or everything. It changes nothing until you type yes.',
  },
];
const extraSchema =
  version.latest && id === 'quick-start'
    ? [howTo(abs(Astro.url.pathname), 'How to scan for PolinRider', 'Install, verify and run polinrider, the free PolinRider scanner, on macOS, Linux or Windows.', quickStartSteps)]
    : [];
---

{entry && Content ? (
  <Docs
    title={entry.data.title}
    description={entry.data.description}
    version={version}
    versions={versions}
    nav={nav}
    id={id}
    headings={rendered!.headings}
    file={entry.filePath}
    canonical={canonical}
    extraSchema={extraSchema}
  >
    <Content />
  </Docs>
) : (
  <Docs
    title="Documentation"
    titleTag="PolinRider Scanner documentation"
    description="How to install the PolinRider scanner, verify it, read its verdict, clean up machines and GitHub in the right order and keep PolinRider out for good."
    version={version}
    versions={versions}
    nav={nav}
    id=""
    canonical={version.latest ? undefined : `${SITE_URL}/docs/`}
  >
    <DocsOverview nav={nav} />
  </Docs>
)}
