---
// The home page, for someone who fears their computer is infected. The first
// screen answers "what is this and what do I run". Then: what it can check,
// the commands, what happens after the scan (one of three answers, each with
// what the tool does and what you do), why it can be trusted and the latest
// news. Every fact here is from the docs it links to.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import RunBlock from '../components/RunBlock.astro';
import LastUpdated from '../components/LastUpdated.astro';
import { elsewhere, inline, newsPosts, reviews } from '../news';
import { longDate } from '../releaseDate';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const d = `${base}/docs`;
const posts = (await newsPosts()).slice(0, 2);
const review = (await reviews())[0];
const outside = (await elsewhere())[0];

const targets = [
  {
    icon: 'computer',
    title: 'This computer',
    text: 'Editor tasks, build configs, fake fonts, what starts by itself and the related MicrosoftSystem64 malware.',
    href: `${d}/guides/machine/`,
    systems: ['macOS', 'Linux', 'Windows'],
  },
  {
    icon: 'user',
    title: 'A GitHub account',
    text: "Every repository, branch and tag you own, read against GitHub's push record.",
    href: `${d}/guides/account/`,
  },
  {
    icon: 'org',
    title: 'A GitHub organization',
    text: 'The same check across every repository the organization owns.',
    href: `${d}/guides/organization/`,
  },
] as const;

const cleanup = [
  {
    icon: 'computer',
    title: 'This computer',
    text: 'Check every computer that touched the affected repositories, before GitHub. Confirmed files move to quarantine, with a manifest to put them back.',
  },
  { icon: 'key', title: 'Credentials', text: 'Rotate every credential, from a computer you trust.' },
  {
    icon: 'repo',
    title: 'Repositories',
    text: "Restore each branch to the newest clean state on GitHub's push record. Where there is none, remove the payload or erase it from history.",
  },
  { icon: 'ci', title: 'Every future push', text: 'Add the scanner to CI, so a reinfection is caught.' },
] as const;

const wont = [
  { icon: 'shield', title: 'Prove you are clean', text: 'Signatures change. Rotate your credentials anyway.' },
  { icon: 'computer', title: 'Make an infected computer safe again', text: 'Quarantine contains it. A clean reinstall recovers it.' },
  { icon: 'box', title: 'Change anything you did not agree to', text: 'Every fix is a dry run first. Nothing is deleted: confirmed files are moved to quarantine.' },
] as const;

const trust = [
  { icon: 'calendar', title: 'Built during a real incident', text: "On the author's own account: 57 repositories and 304 refs. Two of ten restore points were infected too." },
  { icon: 'eye', title: 'Indicators reviewed every week', text: 'And every review is published.', href: `${base}/news/indicator-reviews/` },
  { icon: 'signature', title: 'Every commit is signed', text: 'Every release carries build provenance.' },
  { icon: 'scan', title: 'It scans itself', text: 'In CI, against its own indicators.' },
] as const;
---

<Base
  title="Find and remove PolinRider"
  description="Check a machine, a GitHub account or a whole organization for the PolinRider supply-chain malware, and clean it up safely."
  type="website"
>
  <section class="hero wrap">
    <p class="badge"><span class="dot" aria-hidden="true"></span>Free and open source. macOS, Linux and Windows.</p>
    <h1>Check for PolinRider.<br />Clean it up safely.</h1>
    <p class="tagline">
      One program checks this computer, a GitHub account or a whole organization. It changes nothing until you
      type <code>yes</code>.
    </p>
    <div class="actions">
      <a class="pill" href="#install">Check my computer</a>
      <a class="textlink" href={`${base}/campaign/what-it-is/`}>What is PolinRider? <Icon name="arrow" size={18} /></a>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="checks">
    <h2 id="checks" class="sr-only">What it checks</h2>
    <ul class="targets">
      {targets.map((t) => (
        <li>
          <a class="target card" href={t.href}>
            <span class="ticon"><Icon name={t.icon} size={24} /></span>
            <span class="card-title">{t.title}</span>
            {'systems' in t && (
              <span class="systems">{t.systems.map((s) => <span class="tag">{s}</span>)}</span>
            )}
            <p>{t.text}</p>
            <span class="more">How it works <Icon name="arrow" size={16} /></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="install" class="wrap section narrow run" aria-labelledby="install-h">
    <p class="eyebrow">Step 1</p>
    <h2 id="install-h">Install it and run it</h2>
    <RunBlock />
    <p class="after">
      It asks what to check, one question at a time. Want to
      download and verify the program yourself instead? Use the <a href={`${d}/quick-start/`}>quick start</a>.
    </p>
    <LastUpdated />
  </section>

  <section class="wrap section" aria-labelledby="answers-h">
    <div class="center">
      <p class="eyebrow">Step 2</p>
      <h2 id="answers-h">You get one of three answers</h2>
      <p class="sub">Each one says what the tool did and what you do next.</p>
    </div>

    <div class="answers">
      <article class="answer verdict-compromised">
        <header class="ahead">
          <Icon name="compromised" size={26} />
          <h3>Compromised</h3>
          <span class="exit">exit 2</span>
        </header>
        <p class="what"><strong>It found</strong> something only the malware leaves, prints a <code>[HIT]</code> line for each and lists what to do next, with the exact command for each step.</p>
        <p class="what"><strong>You</strong> clean up in this order. The order is fixed.</p>
        <ol class="cleanup">
          {cleanup.map((c, i) => (
            <li>
              <span class="cnum" aria-hidden="true">{i + 1}</span>
              <span class="cicon"><Icon name={c.icon} size={22} /></span>
              <strong>{c.title}</strong>
              <span>{c.text}</span>
            </li>
          ))}
        </ol>
        <p class="warn">
          <Icon name="review" size={18} />
          <span>Cleaning GitHub while an infected computer still holds a valid token undoes the work within minutes. <a href={`${d}/guides/order/`}>Why the order is fixed</a></span>
        </p>
      </article>

      <div class="pair">
        <article class="answer verdict-review">
          <header class="ahead">
            <Icon name="review" size={26} />
            <h3>Review</h3>
            <span class="exit">exit 1</span>
          </header>
          <p class="what"><strong>It found</strong> something a normal project can also have, and prints a <code>[review]</code> line for each.</p>
          <p class="what"><strong>You</strong> read each line and ask whether you put it there. If one is not yours, treat it as confirmed.</p>
        </article>
        <article class="answer verdict-clean">
          <header class="ahead">
            <Icon name="clean" size={26} />
            <h3>Clean</h3>
            <span class="exit">exit 0</span>
          </header>
          <p class="what"><strong>It found</strong> none of today's indicators. That is not proof that nothing was ever there.</p>
          <p class="what"><strong>You</strong> check it looked where you meant. If you had a reason to check, rotate your credentials anyway.</p>
        </article>
      </div>
    </div>

    <p class="exit3">
      Exit code <code>3</code> means the check could not run. It says nothing either way.{' '}
      <a href={`${base}/news/2026-11-04-polinrider-or-false-alarm/`}>Is it PolinRider or a false alarm?</a>
    </p>
  </section>

  <section class="wrap section" aria-label="What it will not do and why you can run it">
    <div class="trust">
      <div>
        <h2>What it will not do</h2>
        <ul class="points">
          {wont.map((p) => (
            <li>
              <span class="picon"><Icon name={p.icon} size={20} /></span>
              <span><strong>{p.title}.</strong> {p.text}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2>Why you can run it</h2>
        <ul class="points">
          {trust.map((p) => (
            <li>
              <span class="picon"><Icon name={p.icon} size={20} /></span>
              <span><strong>{p.title}.</strong> {'href' in p ? <a href={p.href}>{p.text}</a> : p.text}</span>
            </li>
          ))}
        </ul>
        <p class="checkit">
          <a href={`${d}/reference/verifying/`}>Check all of this yourself</a>
          <span>Project status: <a href="https://github.com/meSingh/polinrider-cleaner/actions/workflows/ci.yml">CI</a>, <a href="https://scorecard.dev/viewer/?uri=github.com/meSingh/polinrider-cleaner">OpenSSF Scorecard</a> and <a href="https://github.com/meSingh/polinrider-cleaner/actions/workflows/codeql.yml">CodeQL</a></span>
        </p>
      </div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="latest-h">
    <div class="latest-head">
      <h2 id="latest-h">Latest</h2>
      <a class="textlink" href={`${base}/news/`}>All news <Icon name="arrow" size={16} /></a>
    </div>
    <ul class="latest">
      {posts.map((p) => (
        <li>
          <a class="card" href={p.href}>
            <span class="card-meta"><span class="tag tag-accent">Our post</span><time datetime={p.date}>{longDate(p.date)}</time></span>
            <span class="card-title">{p.title}</span>
            <p>{p.description}</p>
          </a>
        </li>
      ))}
      {review && (
        <li>
          <a class="card" href={review.href}>
            <span class="card-meta"><span class="tag">Indicator review</span><time datetime={review.date}>{longDate(review.date)}</time></span>
            <span class="card-title">{review.outcome ? review.outcome.charAt(0).toUpperCase() + review.outcome.slice(1) : review.label}</span>
            {review.summary && <p class="clamp" set:html={inline(review.summary)} />}
          </a>
        </li>
      )}
      {outside && (
        <li>
          <a class="card" href={outside.url} target="_blank" rel="noopener noreferrer">
            <span class="card-meta"><span class="tag">Elsewhere</span><span class="src">{outside.source}</span><time datetime={outside.date}>{longDate(outside.date)}</time></span>
            <span class="card-title">{outside.title} <Icon name="external" size={15} class="ext" /><span class="sr-only"> (opens in a new tab)</span></span>
            <p>{outside.summary}</p>
          </a>
        </li>
      )}
    </ul>
  </section>
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: clamp(3rem, 8vw, 5.5rem) 1rem;
    text-align: center;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.75rem;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--pr-border);
    border-radius: 999px;
    font-size: var(--text-xs);
  }
  .dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--pr-accent);
  }
  h1 {
    max-width: 18ch;
    margin: 0;
    font-size: clamp(2.25rem, 1.2rem + 4.2vw, 4rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
  }
  .tagline {
    max-width: 36rem;
    margin: 1.25rem 0 0;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.3125rem);
    line-height: 1.5;
    text-wrap: balance;
  }
  code {
    padding: 0.05em 0.35em;
    border: 1px solid var(--pr-border);
    border-radius: 6px;
    background: var(--pr-surface);
    color: var(--pr-heading);
    font-size: 0.9em;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 1.75rem;
    margin-top: 2rem;
  }

  .section {
    margin-top: clamp(3.5rem, 8vw, 6rem);
  }
  .section h2 {
    margin: 0;
    font-size: clamp(1.625rem, 1.2rem + 1.4vw, 2.125rem);
    letter-spacing: -0.025em;
  }
  .narrow {
    max-width: calc(42rem + 2 * var(--gutter));
  }
  .center {
    text-align: center;
  }
  .sub {
    margin: 0.6rem 0 0;
  }

  /* What it checks */
  .targets {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 50rem) {
    .targets {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .target {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem;
  }
  .ticon,
  .cicon,
  .picon {
    display: inline-grid;
    place-items: center;
    flex: none;
    border: 1px solid var(--pr-border-strong);
    background: var(--pr-bg);
    color: var(--pr-accent);
  }
  .ticon {
    width: 2.9rem;
    height: 2.9rem;
    margin-bottom: 1rem;
    border-radius: 12px;
  }
  .target .card-title {
    font-size: 1.25rem;
  }
  .systems {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.7rem;
  }
  .target p {
    flex: 1;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 1rem;
    color: var(--pr-heading);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  /* Install and run */
  .run {
    text-align: center;
  }
  .run h2 {
    margin-bottom: 1.5rem;
  }
  .run :global(.run-block) {
    text-align: start;
  }
  .after {
    margin: 1.25rem auto 1rem;
    max-width: 36rem;
    font-size: 1rem;
  }

  /* The three answers */
  .answers {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }
  @media (min-width: 62rem) {
    .answers {
      grid-template-columns: 3fr 2fr;
      align-items: start;
    }
  }
  .pair {
    display: grid;
    gap: 1rem;
  }
  .answer {
    padding: 1.5rem;
    border: 1px solid var(--b);
    border-radius: var(--pr-radius);
    background: var(--bg);
  }
  .ahead {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--c);
  }
  .ahead h3 {
    margin: 0;
    color: var(--c);
    font-size: 1.375rem;
  }
  .exit {
    margin-inline-start: auto;
    color: var(--pr-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .what {
    margin: 0.9rem 0 0;
    font-size: 1rem;
  }
  .what strong {
    color: var(--pr-heading);
  }
  .cleanup {
    display: grid;
    gap: 0.75rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }
  @media (min-width: 40rem) {
    .cleanup {
      grid-template-columns: 1fr 1fr;
    }
  }
  .cleanup li {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto 1fr;
    align-items: start;
    gap: 0.2rem 0.75rem;
    padding: 1rem;
    border: 1px solid var(--pr-border);
    border-radius: var(--pr-radius-sm);
    background: var(--pr-bg);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .cleanup .cicon {
    grid-row: span 2;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 10px;
    color: var(--pr-bad);
  }
  .cleanup strong {
    color: var(--pr-heading);
  }
  .cnum {
    position: absolute;
    top: 0.6rem;
    right: 0.75rem;
    color: var(--pr-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .warn {
    display: flex;
    gap: 0.5rem;
    margin: 1rem 0 0;
    color: var(--pr-text);
    font-size: 0.9375rem;
  }
  .warn :global(svg) {
    flex: none;
    margin-top: 0.15rem;
    color: var(--pr-review);
  }
  .exit3 {
    margin: 1.5rem 0 0;
    color: var(--pr-muted);
    font-size: 0.9375rem;
    text-align: center;
  }

  /* Trust */
  .trust {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 56rem) {
    .trust {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }
  .trust h2 {
    font-size: var(--text-h2);
  }
  .points {
    display: grid;
    gap: 1.1rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .points li {
    display: flex;
    gap: 0.9rem;
    font-size: 1rem;
  }
  .points strong {
    color: var(--pr-heading);
  }
  .picon {
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 10px;
  }
  .checkit {
    display: grid;
    gap: 0.4rem;
    margin: 1.5rem 0 0;
    font-size: var(--text-sm);
  }
  .checkit > a {
    font-weight: 600;
  }
  .checkit span {
    color: var(--pr-muted);
  }

  /* Latest */
  .latest-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .latest {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 44rem) {
    .latest {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 72rem) {
    .latest {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .latest .card {
    height: 100%;
  }
  .clamp {
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .src {
    color: var(--pr-heading);
    font-weight: 600;
  }
  .latest :global(.ext) {
    display: inline;
    vertical-align: -0.1em;
    color: var(--pr-muted);
  }
</style>
