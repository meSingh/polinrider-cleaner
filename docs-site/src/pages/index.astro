---
// The home page, for someone who fears their computer or their GitHub is
// infected. The first screen: what this is and three buttons, one for each
// thing it can check. Then the whole process as numbered steps, from
// installing it to what you can do if it finds the malware. Then why there
// is no risk in running it, why it can be trusted and the latest news.
// Every fact is from the docs it links to.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import RunBlock from '../components/RunBlock.astro';
import LastUpdated from '../components/LastUpdated.astro';
import NewsTimeline from '../components/NewsTimeline.astro';
import { Code } from 'astro:components';
import { timeline } from '../news';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const d = `${base}/docs`;
const latest = (await timeline()).slice(0, 4);
const themes = { light: 'github-light-default', dark: 'github-dark-default' } as const;

// The answer to type at "What should I check?" for each button.
const checks = [
  { answer: 'computer', icon: 'computer', label: 'Check my computer', note: 'macOS · Linux · Windows' },
  { answer: 'account', icon: 'user', label: 'Check my GitHub account' },
  { answer: 'organization', icon: 'org', label: 'Check my GitHub organisation' },
] as const;

const repoChoices = [
  ['restore', "Moves each branch back to the newest clean push on GitHub's record. Offered only where that record shows one."],
  ['remove', 'Adds one new commit that takes the malware out. History stays as it is.'],
  ['erase', 'Rewrites history so no commit holds the malware. Every commit ID on those branches changes.'],
  ['archive', 'Marks the repository as infected at the top of its README and makes it read-only. For one nobody uses.'],
  ['skip', 'Leaves it as it is.'],
] as const;

const safety = [
  { icon: 'eye', title: 'It only looks until you type yes', text: 'Every check reads. Nothing on your computer or on GitHub changes until you answer yes.' },
  { icon: 'undo', title: 'Nothing is deleted', text: 'Confirmed files move to a quarantine folder, with a list of how to put each one back.' },
  { icon: 'scan', title: 'You see every change first', text: 'Each fix on GitHub is shown as a dry run of exactly what would change, before you agree.' },
  { icon: 'lock', title: 'It never overwrites newer work', text: 'Every push it makes is refused if someone pushed after the check, so nothing new is lost.' },
] as const;

const trust = [
  { icon: 'doc', title: 'Open source', text: 'Every line is public and MIT licensed. Read what it does before you run it.' },
  { icon: 'signature', title: 'Signed and attested', text: 'Every commit is signed. Every release carries build provenance and SHA256SUMS.', href: `${d}/reference/verifying/`, link: 'Check it yourself' },
  { icon: 'calendar', title: 'Checked every week', text: 'The indicators are reviewed against published reports every week, and every review is public.', href: `${base}/news/indicator-reviews/`, link: 'Read the reviews' },
  { icon: 'shield', title: 'Built during a real cleanup', text: "On the author's own account: 57 repositories and 304 refs. Two of ten restore points were infected too." },
] as const;
---

<Base
  title="Find and remove PolinRider"
  description="Check your computer, a GitHub account or a whole organization for the PolinRider supply-chain malware, and clean it up safely."
  type="website"
>
  <section class="hero wrap">
    <p class="badge"><span class="dot" aria-hidden="true"></span>Free and open source</p>
    <h1>Check for PolinRider.<br />Clean it up safely.</h1>
    <p class="tagline">
      One program checks your computer, your GitHub account or your whole organisation. It changes nothing until
      you type <code>yes</code>.
    </p>
    <div class="checks">
      {checks.map((c) => (
        <a class="check" href="#how" data-answer={c.answer}>
          <Icon name={c.icon} size={20} />
          <span>
            {c.label}
            {'note' in c && <small>{c.note}</small>}
          </span>
        </a>
      ))}
    </div>
    <a class="textlink what" href={`${base}/threat/`}>What is PolinRider? <Icon name="arrow" size={18} /></a>
  </section>

  <section id="how" class="wrap how" aria-labelledby="how-h">
    <h2 id="how-h">How it works</h2>
    <ol class="steps">
      <li>
        <span class="n" aria-hidden="true">1</span>
        <div class="step">
          <h3>Install it</h3>
          <p>Choose your system. Run only its commands.</p>
          <RunBlock install />
        </div>
      </li>
      <li>
        <span class="n" aria-hidden="true">2</span>
        <div class="step">
          <h3>Run it and say what to check</h3>
          <div class="code-block copy-wrap">
            <Code code="polinrider" lang="bash" themes={themes} defaultColor={false} />
          </div>
          <p>
            It asks <em>What should I check?</em> Type <code class="answer-word" data-answer-word>computer</code><span data-answer-others>, or <code>account</code> or <code>organization</code> for GitHub</span>.
            Answers are words, never numbers.
          </p>
        </div>
      </li>
      <li>
        <span class="n" aria-hidden="true">3</span>
        <div class="step">
          <h3>It scans. Nothing changes.</h3>
          <p>
            It only reads, and shows each check as it runs. A GitHub check copies every repository first, so the
            evidence is kept before anything is touched.
          </p>
        </div>
      </li>
      <li>
        <span class="n" aria-hidden="true">4</span>
        <div class="step">
          <h3>You get one of three answers</h3>
          <div class="answers">
            <div class="answer verdict-clean">
              <p class="ah"><Icon name="clean" size={22} /><strong>Clean</strong></p>
              <p>None of today's signs found. Not proof it was never there: if you had a reason to check, change your passwords and tokens anyway.</p>
            </div>
            <div class="answer verdict-review">
              <p class="ah"><Icon name="review" size={22} /><strong>Review</strong></p>
              <p>Something a normal project can also have. Read each <code>[review]</code> line and ask: did I put this here? If not, treat it as found.</p>
            </div>
            <div class="answer verdict-compromised">
              <p class="ah"><Icon name="compromised" size={22} /><strong>Compromised</strong></p>
              <p>Something only the malware leaves. It lists what it found and the exact command for each next step. Go to step 5.</p>
            </div>
          </div>
          <p class="small">
            If it says it could not run, it tells you why, and it found nothing either way.{' '}
            <a href={`${base}/news/2026-11-04-polinrider-or-false-alarm/`}>Is it PolinRider or a false alarm?</a>
          </p>
        </div>
      </li>
      <li>
        <span class="n bad" aria-hidden="true">5</span>
        <div class="step">
          <h3>If it is compromised, these are your choices, in this order</h3>
          <p class="order-note">
            The order is fixed. If you clean GitHub while an infected computer still holds a valid token, the
            malware pushes itself back within minutes. <a href={`${d}/guides/order/`}>Why</a>
          </p>

          <div class="choice">
            <h4><Icon name="computer" size={20} />This computer</h4>
            <p>
              Type <code>yes</code> and every confirmed file moves into a quarantine folder, with a list of how to
              put each one back. Nothing is deleted. A startup entry, a crontab line or a shell startup file is
              never changed for you: it prints the command that removes it.
            </p>
            <p>
              If it says <em>This machine cannot be trusted until it is rebuilt</em>, quarantine contains it but
              only a clean reinstall makes it safe. <a href={`${d}/guides/machine/`}>Checking a computer</a>
            </p>
          </div>

          <div class="choice">
            <h4><Icon name="key" size={20} />Your passwords and tokens</h4>
            <p>
              Change every one, from a different computer you trust: GitHub tokens and SSH keys, npm and cloud
              tokens, and the passwords saved in your browser.
            </p>
          </div>

          <div class="choice">
            <h4><Icon name="repo" size={20} />Your repositories</h4>
            <p>For each infected repository it asks what to do:</p>
            <dl class="opts">
              {repoChoices.map(([word, text]) => (
                <>
                  <dt><code>{word}</code></dt>
                  <dd>{text}</dd>
                </>
              ))}
            </dl>
            <p>
              Each one shows exactly what would change on GitHub and pushes only after you type <code>yes</code>.
              Afterwards, delete every local copy and clone it again.{' '}
              <a href={`${d}/guides/account/`}>A GitHub account</a> · <a href={`${d}/guides/organization/`}>An organisation</a>
            </p>
          </div>

          <div class="choice">
            <h4><Icon name="ci" size={20} />Every future push</h4>
            <p>
              Add the scanner to your CI, so a reinfection is caught on the next push.{' '}
              <a href={`${d}/guides/ci/`}>Every future push</a>
            </p>
          </div>
        </div>
      </li>
    </ol>
    <LastUpdated align="start" />
  </section>

  <section class="wrap band" aria-labelledby="safe-h">
    <h2 id="safe-h">No risk in running it</h2>
    <ul class="grid4">
      {safety.map((s) => (
        <li>
          <span class="picon"><Icon name={s.icon} size={22} /></span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ul>
    <p class="small">
      What it cannot promise: signatures change, so a clean result is about today's signs. Change your passwords
      anyway if you had a reason to check. <a href={`${d}/project/disclaimer/`}>The full disclaimer</a>
    </p>
  </section>

  <section class="wrap band" aria-labelledby="trust-h">
    <h2 id="trust-h">Why you can trust it</h2>
    <ul class="grid4">
      {trust.map((t) => (
        <li>
          <span class="picon"><Icon name={t.icon} size={22} /></span>
          <h3>{t.title}</h3>
          <p>{t.text}</p>
          {'href' in t && <a href={t.href}>{t.link}</a>}
        </li>
      ))}
    </ul>
    <p class="small">
      Project status: <a href="https://github.com/meSingh/polinrider-cleaner/actions/workflows/ci.yml">CI</a>,{' '}
      <a href="https://scorecard.dev/viewer/?uri=github.com/meSingh/polinrider-cleaner">OpenSSF Scorecard</a> and{' '}
      <a href="https://github.com/meSingh/polinrider-cleaner/actions/workflows/codeql.yml">CodeQL</a>
    </p>
  </section>

  <section class="wrap latest" aria-labelledby="latest-h">
    <div class="latest-head">
      <h2 id="latest-h">Latest</h2>
      <a class="textlink" href={`${base}/news/`}>All news <Icon name="arrow" size={16} /></a>
    </div>
    <NewsTimeline items={latest} />
  </section>
</Base>

<script>
  // A check button sets the word to type in step 2, then the link scrolls
  // there. Without JavaScript step 2 lists all three words.
  const word = document.querySelector<HTMLElement>('[data-answer-word]');
  const others = document.querySelector<HTMLElement>('[data-answer-others]');
  for (const a of document.querySelectorAll<HTMLAnchorElement>('.check[data-answer]')) {
    a.addEventListener('click', () => {
      if (word) word.textContent = a.dataset.answer ?? 'computer';
      if (others) others.hidden = true;
    });
  }
</script>

<style>
  code {
    padding: 0.05em 0.35em;
    border: 1px solid var(--pr-border);
    border-radius: 6px;
    background: var(--pr-surface);
    color: var(--pr-heading);
    font-size: 0.88em;
  }
  .answer-word {
    border-color: var(--pr-accent);
    background: var(--pr-accent-bg);
  }
  h2 {
    margin: 0;
    font-size: clamp(1.625rem, 1.2rem + 1.4vw, 2.125rem);
    letter-spacing: -0.025em;
  }
  .small {
    color: var(--pr-muted);
    font-size: var(--text-sm);
  }

  /* Hero */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: clamp(3rem, 8vw, 5.5rem) 1rem;
    text-align: center;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.75rem;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--pr-border);
    border-radius: 999px;
    font-size: var(--text-xs);
  }
  .dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--pr-accent);
  }
  h1 {
    max-width: 18ch;
    margin: 0;
    font-size: clamp(2.25rem, 1.2rem + 4.2vw, 4rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
  }
  .tagline {
    max-width: 38rem;
    margin: 1.25rem 0 0;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.3125rem);
    line-height: 1.5;
    text-wrap: balance;
  }
  .checks {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
  .check {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1.3rem;
    border: 1px solid var(--pr-border-strong);
    border-radius: 999px;
    background: var(--pr-bg);
    color: var(--pr-heading);
    font-size: 1rem;
    font-weight: 600;
    text-align: start;
    text-decoration: none;
  }
  .check:first-child {
    border-color: var(--pr-pill-bg);
    background: var(--pr-pill-bg);
    color: var(--pr-pill-text);
  }
  .check:hover {
    border-color: var(--pr-heading);
    color: var(--pr-heading);
  }
  .check:first-child:hover {
    color: var(--pr-pill-text);
    opacity: 0.88;
  }
  .check small {
    display: block;
    font-size: 0.75rem;
    font-weight: 500;
    opacity: 0.8;
  }
  .what {
    margin-top: 1.5rem;
  }

  /* How it works */
  .how {
    margin-top: clamp(3.5rem, 8vw, 6rem);
    scroll-margin-top: calc(var(--nav-height) + 1rem);
  }
  .steps {
    max-width: 56rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }
  .steps > li {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0 1.25rem;
    padding-bottom: 2.5rem;
  }
  .steps > li::after {
    content: '';
    position: absolute;
    top: 2.75rem;
    bottom: 0.5rem;
    left: 1.25rem;
    width: 1px;
    background: var(--pr-border);
  }
  .steps > li:last-child::after {
    display: none;
  }
  .n {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--pr-border-strong);
    border-radius: 50%;
    background: var(--pr-bg);
    color: var(--pr-heading);
    font-weight: 650;
  }
  .n.bad {
    border-color: var(--pr-bad-border);
    background: var(--pr-bad-bg);
    color: var(--pr-bad);
  }
  .step {
    min-width: 0;
  }
  .step h3 {
    margin: 0.4rem 0 0.6rem;
    font-size: 1.375rem;
  }
  .step p {
    margin: 0.6rem 0 0;
  }
  .step :global(.run-block),
  .step .code-block {
    margin-top: 0.9rem;
  }
  .step .code-block :global(pre) {
    margin: 0;
    padding: 0.9rem 6.5rem 0.9rem 1.25rem;
    border: 1px solid var(--pr-border);
    border-radius: var(--pr-radius);
    background: var(--pr-code-bg) !important;
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .step .code-block :global(.copy-btn) {
    opacity: 1;
  }
  .answers {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  @media (min-width: 46rem) {
    .answers {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .answer {
    padding: 1rem 1.1rem;
    border: 1px solid var(--b);
    border-radius: var(--pr-radius);
    background: var(--bg);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .answer p {
    margin: 0.5rem 0 0;
  }
  .answer .ah {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--c);
  }
  .ah strong {
    color: var(--c);
    font-size: 1.125rem;
  }
  .order-note {
    padding: 0.8rem 1rem;
    border-inline-start: 3px solid var(--pr-review);
    border-radius: var(--pr-radius-sm);
    background: var(--pr-review-bg);
    font-size: 0.9375rem;
  }
  .choice {
    margin-top: 1.5rem;
  }
  .choice h4 {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    color: var(--pr-heading);
    font-size: 1.125rem;
  }
  .choice h4 :global(svg) {
    color: var(--pr-accent);
  }
  .choice p {
    font-size: 1rem;
  }
  .opts {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.5rem 1rem;
    margin: 0.75rem 0 0;
    font-size: 1rem;
  }
  .opts dd {
    margin: 0;
  }

  /* Safety and trust */
  .band {
    margin-top: clamp(3rem, 7vw, 5rem);
  }
  .grid4 {
    display: grid;
    gap: 1rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 40rem) {
    .grid4 {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 66rem) {
    .grid4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .grid4 li {
    padding: 1.3rem;
    border: 1px solid var(--pr-border);
    border-radius: var(--pr-radius);
    background: var(--pr-surface);
  }
  .grid4 h3 {
    margin: 0.9rem 0 0.4rem;
    font-size: 1.0625rem;
  }
  .grid4 p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .grid4 a {
    display: inline-block;
    margin-top: 0.6rem;
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .picon {
    display: inline-grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--pr-border-strong);
    border-radius: 12px;
    background: var(--pr-bg);
    color: var(--pr-accent);
  }

  /* Latest */
  .latest {
    margin-top: clamp(3rem, 7vw, 5rem);
  }
  .latest-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
</style>
