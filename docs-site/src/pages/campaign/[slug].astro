---
// A page about the campaign itself: what PolinRider is, how it hides and
// the indicators. Standalone pages, with no docs sidebar.
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';

export async function getStaticPaths() {
  return (await getCollection('campaign')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Article
  title={entry.data.title}
  description={entry.data.description}
  crumbs={[{ label: 'The campaign', href: `${base}/campaign/` }]}
  headings={headings}
  section="The campaign"
  file={entry.filePath}
>
  <Content />
</Article>
