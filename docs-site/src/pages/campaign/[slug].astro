---
// A page about the campaign itself: what PolinRider is, how it hides and
// the indicators. Standalone pages, with no docs sidebar.
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';

export async function getStaticPaths() {
  return (await getCollection('campaign')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// The campaign pages in reading order; the others are offered at the end.
const order = ['what-it-is', 'how-it-hides', 'indicators'];
const others = (await getCollection('campaign'))
  .filter((e) => e.id !== entry.id)
  .sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
---

<Article
  title={entry.data.title}
  description={entry.data.description}
  crumbs={[{ label: 'The campaign', href: `${base}/campaign/` }]}
  headings={headings}
  section="The campaign"
  file={entry.filePath}
>
  <Content />
  <nav slot="after" class="next no-print" aria-label="More about the campaign">
    <p class="eyebrow">More about the campaign</p>
    <ul>
      {others.map((o) => (
        <li>
          <a class="card" href={`${base}/campaign/${o.id}/`}>
            <span class="card-title">{o.data.title}</span>
            {o.data.description && <p>{o.data.description}</p>}
          </a>
        </li>
      ))}
      <li>
        <a class="card" href={`${base}/news/#elsewhere`}>
          <span class="card-title">What others have published</span>
          <p>Research and news about PolinRider from other publishers, each article read before it was listed.</p>
        </a>
      </li>
    </ul>
  </nav>
</Article>

<style>
  .next {
    margin-top: 3rem;
  }
  .next ul {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 40rem) {
    .next ul {
      grid-template-columns: 1fr 1fr;
    }
  }
  .next .card {
    height: 100%;
  }
</style>
