---
// Design options for Mandeep to choose from: eight headlines and six logo
// marks. Not linked from anywhere, not indexed (noindex, left out of the
// sitemap and of search). Delete the page once he has chosen.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const checks = [
  { icon: 'computer', label: 'Check my computer', note: 'macOS · Linux · Windows' },
  { icon: 'user', label: 'Check my GitHub account' },
  { icon: 'org', label: 'Check my GitHub organisation' },
] as const;

// The pill and subline Mandeep chose, with eight headlines to pick from. Each
// is two lines, the second in the accent colour, and claims nothing we
// cannot back (no speed, no completeness, no guarantee).
const pill = 'Open source PolinRider malware scanner and cleaner';
const sub =
  'One open source program checks your computer, your GitHub account and your organisation for PolinRider malware, and helps you remove it safely.';
const heroes = [
  { id: '1', angle: 'Outcome', before: 'Get PolinRider out.', accent: 'Keep it out.' },
  { id: '2', angle: 'Action', before: 'Find PolinRider. Remove it.', accent: 'Keep it out of your code.' },
  { id: '3', angle: 'Reassurance', before: 'Clean up PolinRider', accent: 'without making it worse.' },
  { id: '4', angle: 'Reassurance', before: 'Scan for PolinRider.', accent: 'Nothing changes until you say yes.' },
  { id: '5', angle: 'Urgency, calm', before: 'PolinRider spreads through your pushes.', accent: 'Stop it at the source.' },
  { id: '6', angle: 'Three beats', before: 'Scan for PolinRider.', accent: 'Clean up. Keep watch.' },
  { id: '7', angle: 'Question', before: 'Is PolinRider on your computer?', accent: 'Check, then clean up in order.' },
  { id: '8', angle: 'Name it', before: 'The PolinRider cleaner.', accent: 'Open source. Careful. Free.' },
];

// Six original marks from the logo-design process (a brief, the library's
// security and branch marks as the category to avoid, then build, render,
// audit, the 16px, one-colour and reversed tests). Drawn on a 256 grid.
// --ink is the mark's colour, --acc the brand colour for its two-tone form;
// in the one-colour rows both are the same.
const marks = [
  { id: 'A', name: 'Clean commit', rationale: 'A commit in the history, ringed and checked, with the branch carrying on clean.', svg: "<g transform=\"translate(-12 -1)\"><g fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"26\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n<path d=\"M104 238V196\"/><circle cx=\"104\" cy=\"134\" r=\"60\"/><path d=\"M76 132 98 154 206 46\"/></g>\n<circle cx=\"214\" cy=\"38\" r=\"22\" fill=\"var(--acc)\"/></g>" },
  { id: 'B', name: 'Sweep', rationale: 'One stroke sweeps the infected stretch out of a branch; the commits either side stay.', svg: "<g fill=\"none\" stroke=\"var(--ink)\" stroke-linecap=\"round\"><path d=\"M76 40v50M76 170v46\" stroke-width=\"24\"/>\n<path d=\"M26 172C86 112 150 96 232 96\" stroke-width=\"30\" stroke=\"var(--acc)\"/>\n<path d=\"M120 196C152 172 188 162 228 158\" stroke-width=\"16\"/></g>\n<circle cx=\"76\" cy=\"36\" r=\"26\" fill=\"var(--ink)\"/><circle cx=\"76\" cy=\"220\" r=\"26\" fill=\"var(--ink)\"/>" },
