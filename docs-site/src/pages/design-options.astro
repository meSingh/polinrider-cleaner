---
// Design options for Mandeep to choose from: eight headlines, a logo
// exploration grid and four logo marks. Not linked from anywhere, not indexed (noindex, left out of the
// sitemap and of search). Delete the page once he has chosen.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const checks = [
  { icon: 'computer', label: 'Check my computer', note: 'macOS · Linux · Windows' },
  { icon: 'user', label: 'Check my GitHub account' },
  { icon: 'org', label: 'Check my GitHub organisation' },
] as const;

// The pill and subline Mandeep chose, with eight headlines to pick from,
// written for someone under attack with no room to decode a clever line:
// each says "PolinRider" and "malware" or "threat", says what this is or
// what to do (scan or check, remove or clean up), and claims nothing we
// cannot back. The second line is in the accent colour.
const pill = 'Open source PolinRider malware scanner and cleaner';
const sub =
  'One open source program checks your computer, your GitHub account and your organisation for PolinRider malware, and helps you remove it safely.';
const heroes = [
  { id: '1', angle: 'Question, then the fix', before: 'Got PolinRider malware?', accent: 'Scan for it and remove it safely.' },
  { id: '2', angle: 'What it does', before: 'Remove PolinRider malware', accent: 'from your computer and your GitHub.' },
  { id: '3', angle: 'What it is', before: 'PolinRider malware scanner', accent: 'and step-by-step removal tool.' },
  { id: '4', angle: 'Worry, then action', before: 'Worried about PolinRider malware?', accent: 'Check your computer and GitHub now.' },
  { id: '5', angle: 'Two steps', before: 'Scan for PolinRider malware.', accent: 'Then clean up, one step at a time.' },
  { id: '6', angle: 'Under attack', before: 'Under attack by PolinRider?', accent: 'Find the malware and remove it safely.' },
  { id: '7', angle: 'The threat', before: 'The PolinRider threat on your machine?', accent: 'Scan it, then clean it up.' },
  { id: '8', angle: 'Free and plain', before: 'Free PolinRider malware removal', accent: 'for your computer and GitHub.' },
];

// Logos, round 6. Image generation was not available in this session (the
// AI Gateway account has no payment method; design-shotgun needs an OpenAI
// key), so the exploration is twenty quick sketches drawn in code across
// five styles. Four were shortlisted and redrawn, then tested with the
// logo-design skill at 16 and 32px, in one colour and reversed. All
// original geometry. --ink is the mark, --acc the brand colour for its
// two-tone form, --bgc the background (for cut-outs such as an eye).
const sketches = [{"num": "01", "label": "letter P scan", "svg": "<path fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"30\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M78 222V40h58a50 50 0 0 1 0 100H78\"/><path fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"16\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M36 92H220\"/>", "note": "reads as the peso sign"}, {"num": "02", "label": "letter pr stencil", "svg": "<path fill=\"var(--ink)\" d=\"M40 60h40v156H40z M92 60h44a48 48 0 0 1 0 96H92v-36h40a12 12 0 0 0 0-24H92z M188 112c0-30 18-52 50-52v38c-10 0-14 6-14 16v102h-36z\"/>", "note": "reads as Adobe Premiere"}, {"num": "03", "label": "letter P node", "svg": "<path fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"28\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M84 226V128\"/><circle cx=\"128\" cy=\"92\" r=\"52\" fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"28\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"84\" cy=\"226\" r=\"6\" fill=\"var(--ink)\"/>", "note": "shortlisted as D"}, {"num": "04", "label": "letter PR ligature", "svg": "<path fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"26\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M62 226V36h60a44 44 0 0 1 0 88H62M122 124h20a44 44 0 0 1 44 44v58M150 124l60 102\"/>", "note": "a plain R, nothing ownable"}, {"num": "05", "label": "abstract hex cut", "svg": "<path fill=\"var(--ink)\" d=\"M128 20 222 74v108l-94 54-94-54V74z M128 128 222 74 222 182z\" fill-rule=\"evenodd\"/>", "note": "reads as Pac-Man"}, {"num": "06", "label": "abstract scoop", "svg": "<path fill=\"var(--ink)\" fill-rule=\"evenodd\" d=\"M128 24a104 104 0 1 0 0 208 104 104 0 0 0 0-208Z M196 60a52 52 0 1 0 0.1 0Z\"/><circle cx=\"224\" cy=\"40\" r=\"16\" fill=\"var(--ink)\"/>", "note": "shortlisted as B"}, {"num": "07", "label": "abstract stripes", "svg": "<g fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"22\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M60 72h136\"/><path d=\"M60 112h136\"/><path d=\"M60 152h52\"/><path d=\"M60 192h136\"/></g>", "note": "reads as a text-align icon"}, {"num": "08", "label": "abstract offset squares", "svg": "<rect x=\"40\" y=\"40\" width=\"120\" height=\"120\" rx=\"24\" fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"22\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><rect x=\"96\" y=\"96\" width=\"120\" height=\"120\" rx=\"24\" fill=\"var(--ink)\"/>", "note": "reads as a copy icon"}, {"num": "09", "label": "abstract drain", "svg": "<path fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"22\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M128 128m-96 0a96 96 0 1 0 96-96 M128 128m-56 0a56 56 0 1 0 56-56\"/><circle cx=\"128\" cy=\"128\" r=\"16\" fill=\"var(--ink)\"/>", "note": "reads as a radar or @"}, {"num": "10", "label": "mascot owl", "svg": "<circle cx=\"88\" cy=\"112\" r=\"40\" fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"22\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"168\" cy=\"112\" r=\"40\" fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"22\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"88\" cy=\"112\" r=\"10\" fill=\"var(--ink)\"/><circle cx=\"168\" cy=\"112\" r=\"10\" fill=\"var(--ink)\"/><path fill=\"var(--ink)\" d=\"M128 150l-18 24h36z\"/><path fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"22\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M48 80 36 44M208 80l12-36\"/>", "note": "cute, but says nothing about cleaning"}, {"num": "11", "label": "mascot hedgehog", "svg": "<path fill=\"var(--ink)\" d=\"M36 196a92 92 0 0 1 184 0z\"/><path fill=\"var(--ink)\" d=\"M60 128 40 96l44 8zM96 100 84 60l36 28zM140 92l12-40 18 44zM178 112l30-32-4 46z\"/><circle cx=\"196\" cy=\"168\" r=\"8\" fill=\"var(--bgc)\"/>", "note": "reads as a sun or crown"}, {"num": "12", "label": "mascot cat", "svg": "<path fill=\"var(--ink)\" d=\"M48 216V64l52 48h56l52-48v152a24 24 0 0 1-24 24H72a24 24 0 0 1-24-24Z\"/><circle cx=\"100\" cy=\"164\" r=\"12\" fill=\"var(--bgc)\"/><circle cx=\"156\" cy=\"164\" r=\"12\" fill=\"var(--bgc)\"/>", "note": "a generic cat"}, {"num": "13", "label": "mascot woodpecker", "svg": "<path fill=\"var(--ink)\" d=\"M84 228V96a60 60 0 0 1 120 0v12L248 124l-44 12v92z\"/><circle cx=\"150\" cy=\"96\" r=\"12\" fill=\"var(--bgc)\"/><path fill=\"var(--ink)\" d=\"M48 40l44 44-12 12z\"/>", "note": "shortlisted as A"}, {"num": "14", "label": "badge gauge check", "svg": "<circle cx=\"128\" cy=\"128\" r=\"100\" fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"20\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M88 130l28 28 56-60\"/><g fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"10\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M128 14v16M242 128h-16M128 242v-16M14 128h16\"/></g>", "note": "crosshair clich\u00e9"}, {"num": "15", "label": "badge tile pr", "svg": "<rect x=\"20\" y=\"20\" width=\"216\" height=\"216\" rx=\"56\" fill=\"var(--ink)\"/><path fill=\"none\" stroke=\"var(--bgc)\" stroke-width=\"24\" stroke-linecap=\"round\" d=\"M84 190V70h34a32 32 0 0 1 0 64H84M150 190v-48a40 40 0 0 1 40-40\"/>", "note": "reads as Adobe Premiere"}, {"num": "16", "label": "badge octagon bar", "svg": "<path fill=\"var(--ink)\" fill-rule=\"evenodd\" d=\"M86 20h84l66 66v84l-66 66H86L20 170V86z M64 112h128v32H64z\"/>", "note": "reads as a no-entry sign"}, {"num": "17", "label": "geo quadrants", "svg": "<rect x=\"28\" y=\"28\" width=\"92\" height=\"92\" rx=\"14\" fill=\"var(--ink)\"/><rect x=\"136\" y=\"28\" width=\"92\" height=\"92\" rx=\"14\" fill=\"var(--ink)\"/><rect x=\"28\" y=\"136\" width=\"92\" height=\"92\" rx=\"14\" fill=\"var(--ink)\"/><rect x=\"136\" y=\"136\" width=\"92\" height=\"92\" rx=\"46\" fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"18\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>", "note": "reads as an app grid"}, {"num": "18", "label": "geo funnel", "svg": "<path fill=\"var(--ink)\" d=\"M28 40h200l-76 96v80l-48 24V136z\"/>", "note": "reads as a filter icon"}, {"num": "19", "label": "geo viewfinder", "svg": "<g fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"24\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M36 92V36h56M164 36h56v56M220 164v56h-56M92 220H36v-56\"/></g><circle cx=\"128\" cy=\"128\" r=\"30\" fill=\"var(--ink)\"/>", "note": "shortlisted as C"}, {"num": "20", "label": "geo capsule split", "svg": "<rect x=\"28\" y=\"84\" width=\"200\" height=\"88\" rx=\"44\" fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"20\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path fill=\"var(--ink)\" d=\"M128 84h56a44 44 0 0 1 0 88h-56z\"/>", "note": "reads as a toggle switch"}];
