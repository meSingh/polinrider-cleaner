    <ul>
      {marks.map((m) => (
        <li>
          <p class="mark-name">{m.id === 'now' ? m.name : `${m.id}. ${m.name}`}</p>
          <p class="mark-note">{m.rationale}</p>
          <div class="panels">
            {['light', 'dark'].map((t) => (
              <div class:list={['panel', t]}>
                <div class="row">
                  <span class="row-label">Two-tone</span>
                  <div class="sizes">
                    {[16, 32, 64].map((px) => (
                      <span class="size">
                        <svg viewBox="0 0 256 256" width={px} height={px} aria-hidden="true" set:html={m.svg} />
                        <small>{px}</small>
                      </span>
                    ))}
                  </div>
                  <div class="lockup">
                    <svg viewBox="0 0 256 256" width="30" height="30" aria-hidden="true" set:html={m.svg} />
                    <span>polinrider</span>
                  </div>
                </div>
                <div class="row mono">
                  <span class="row-label">One colour</span>
                  <div class="sizes">
                    {[16, 32, 64].map((px) => (
                      <span class="size">
                        <svg viewBox="0 0 256 256" width={px} height={px} aria-hidden="true" set:html={m.svg} />
                        <small>{px}</small>
                      </span>
                    ))}
                  </div>
                  <span class="tab">
                    <svg viewBox="0 0 256 256" width="16" height="16" aria-hidden="true" set:html={m.svg} />
                    PolinRider malware scanner…
                  </span>
                </div>
              </div>
            ))}
          </div>
        </li>
      ))}
    </ul>
  </section>
