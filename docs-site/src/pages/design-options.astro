78.2 107.2 163.8 109.0 147.6L141.4 154.8C152.2 156.6 159.4 147.6 155.8 136.8L148.6 122.4C136.0 99.0 118.0 81.0 94.6 70.2L87.4 46.8L74.8 64.8L64.0 43.2L55.0 68.4C31.6 81.0 19.0 106.2 17.2 135.0C15.4 163.8 24.4 194.4 13.6 226.8ZM88.3 108.0a8.1 8.1 0 1 0 16.2 0a8.1 8.1 0 1 0 -16.2 0Z\"/><path d=\"M70 64C104 26 156 18 196 40\" fill=\"none\" stroke=\"var(--acc)\" stroke-width=\"14\" stroke-linecap=\"round\" data-accent=\"1\"/><g transform=\"rotate(24 206 92)\"><path fill=\"var(--ink)\" fill-rule=\"evenodd\" d=\"M185.8 102.9A25.2 25.2 0 1 1 226.2 102.9L220.3 110.5V121.4Q220.3 125.6 216.1 125.6H195.9Q191.7 125.6 191.7 121.4V110.5ZM190.5 93.7a6.3 6.3 0 1 0 12.6 0a6.3 6.3 0 1 0 -12.6 0ZM208.9 93.7a6.3 6.3 0 1 0 12.6 0a6.3 6.3 0 1 0 -12.6 0ZM206.0 102.1L203.1 108.0H208.9ZM198.4 113.8h2.5v8.4h-2.5ZM204.7 113.8h2.5v8.4h-2.5ZM211.0 113.8h2.5v8.4h-2.5Z\"/></g>"]]}, {"id": "D", "name": "Knight, cleared", "rationale": "The horse without its rider, cut cleanly from a disc: what is left once PolinRider is gone. The strongest at 16px.", "variants": [["", "<path fill=\"var(--ink)\" fill-rule=\"evenodd\" d=\"M12.0 128.0a116.0 116.0 0 1 0 232.0 0a116.0 116.0 0 1 0 -232.0 0ZM65.0 205.5H178.6L171.7 178.0C163.1 159.1 154.5 145.3 156.2 129.8L187.2 136.7C197.5 138.4 204.4 129.8 200.9 119.5L194.0 105.8C182.0 83.4 164.8 66.2 142.4 55.9L135.6 33.5L123.5 50.7L113.2 30.1L104.6 54.2C82.2 66.2 70.2 90.3 68.5 117.8C66.8 145.3 75.4 174.6 65.0 205.5Z\"/><circle cx=\"144\" cy=\"92\" r=\"9\" fill=\"var(--acc)\" data-accent=\"1\"/>"]]}, {"id": "E", "name": "The rider, caught", "rationale": "Mandeep's literal idea, the skull rider on its horse, held inside the scan ring.", "variants": [["With cap", "<path fill=\"var(--ink)\" fill-rule=\"evenodd\" d=\"M91.5 201.8H181.3L175.8 180.0C169.0 165.0 162.2 154.2 163.6 141.9L188.1 147.4C196.2 148.7 201.7 141.9 199.0 133.8L193.5 122.9C184.0 105.2 170.4 91.6 152.7 83.4L147.3 65.8L137.8 79.4L129.6 63.0L122.8 82.1C105.1 91.6 95.6 110.6 94.2 132.4C92.9 154.2 99.7 177.3 91.5 201.8ZM148.0 112.0a6.1 6.1 0 1 0 12.2 0a6.1 6.1 0 1 0 -12.2 0Z\"/><path d=\"M80.7 113.4A21.6 21.6 0 1 1 115.3 113.4L110.2 119.8V129.2Q110.2 132.8 106.6 132.8H89.4Q85.8 132.8 85.8 129.2V119.8Z\" fill=\"var(--bgc)\" stroke=\"var(--bgc)\" stroke-width=\"14\" stroke-linejoin=\"round\"/><path d=\"M67.0 75.9Q98.0 63.0 129.0 75.9L122.5 81.0H73.5ZM75.0 82.8H121.0V86.7H75.0ZM72.1 88.5H123.9Q114.6 95.4 98.0 96.1Q81.4 95.4 72.1 88.5Z\" fill=\"var(--bgc)\" stroke=\"var(--bgc)\" stroke-width=\"14\" stroke-linejoin=\"round\"/><path fill=\"var(--ink)\" fill-rule=\"evenodd\" d=\"M80.7 113.4A21.6 21.6 0 1 1 115.3 113.4L110.2 119.8V129.2Q110.2 132.8 106.6 132.8H89.4Q85.8 132.8 85.8 129.2V119.8ZM84.7 105.4a5.4 5.4 0 1 0 10.8 0a5.4 5.4 0 1 0 -10.8 0ZM100.5 105.4a5.4 5.4 0 1 0 10.8 0a5.4 5.4 0 1 0 -10.8 0ZM98.0 112.6L95.5 117.7H100.5ZM91.5 122.7h2.2v7.2h-2.2ZM96.9 122.7h2.2v7.2h-2.2ZM102.3 122.7h2.2v7.2h-2.2Z\"/><path fill=\"var(--ink)\" d=\"M67.0 75.9Q98.0 63.0 129.0 75.9L122.5 81.0H73.5ZM75.0 82.8H121.0V86.7H75.0ZM72.1 88.5H123.9Q114.6 95.4 98.0 96.1Q81.4 95.4 72.1 88.5Z\"/><circle cx=\"128\" cy=\"128\" r=\"114\" fill=\"none\" stroke=\"var(--acc)\" stroke-width=\"14\" data-accent=\"1\"/><g stroke=\"var(--acc)\" stroke-width=\"14\" stroke-linecap=\"round\" data-accent=\"1\"><path d=\"M128 6v22M250 128h-22M128 250v-22M6 128h22\"/></g>"], ["Without cap", "<path fill=\"var(--ink)\" fill-rule=\"evenodd\" d=\"M91.5 201.8H181.3L175.8 180.0C169.0 165.0 162.2 154.2 163.6 141.9L188.1 147.4C196.2 148.7 201.7 141.9 199.0 133.8L193.5 122.9C184.0 105.2 170.4 91.6 152.7 83.4L147.3 65.8L137.8 79.4L129.6 63.0L122.8 82.1C105.1 91.6 95.6 110.6 94.2 132.4C92.9 154.2 99.7 177.3 91.5 201.8ZM148.0 112.0a6.1 6.1 0 1 0 12.2 0a6.1 6.1 0 1 0 -12.2 0Z\"/><path d=\"M80.7 113.4A21.6 21.6 0 1 1 115.3 113.4L110.2 119.8V129.2Q110.2 132.8 106.6 132.8H89.4Q85.8 132.8 85.8 129.2V119.8Z\" fill=\"var(--bgc)\" stroke=\"var(--bgc)\" stroke-width=\"14\" stroke-linejoin=\"round\"/><path fill=\"var(--ink)\" fill-rule=\"evenodd\" d=\"M80.7 113.4A21.6 21.6 0 1 1 115.3 113.4L110.2 119.8V129.2Q110.2 132.8 106.6 132.8H89.4Q85.8 132.8 85.8 129.2V119.8ZM84.7 105.4a5.4 5.4 0 1 0 10.8 0a5.4 5.4 0 1 0 -10.8 0ZM100.5 105.4a5.4 5.4 0 1 0 10.8 0a5.4 5.4 0 1 0 -10.8 0ZM98.0 112.6L95.5 117.7H100.5ZM91.5 122.7h2.2v7.2h-2.2ZM96.9 122.7h2.2v7.2h-2.2ZM102.3 122.7h2.2v7.2h-2.2Z\"/><circle cx=\"128\" cy=\"128\" r=\"114\" fill=\"none\" stroke=\"var(--acc)\" stroke-width=\"14\" data-accent=\"1\"/><g stroke=\"var(--acc)\" stroke-width=\"14\" stroke-linecap=\"round\" data-accent=\"1\"><path d=\"M128 6v22M250 128h-22M128 250v-22M6 128h22\"/></g>"]]}];
---

<Base title="Design options" description="Logo options for review." noindex hasCanonical={false}>
  <div class="wrap intro">
    <p class="eyebrow">For Mandeep</p>
    <h1>Logo options: the rider</h1>
    <p>
      Five marks in the spirit of the skeleton rider, drawn from the defender's side. Pick one. This page is not linked
      anywhere and is not indexed. The home page headline is now option 6.
    </p>

    <section class="source" aria-labelledby="source-h">
      <h2 id="source-h">Where the image comes from</h2>
      <p>
        The picture most often shown for PolinRider is the banner of OpenSourceMalware's dossier,{' '}
        <a href="https://github.com/OpenSourceMalware/PolinRider" target="_blank" rel="noopener noreferrer">OpenSourceMalware/PolinRider</a>{' '}
        on GitHub (<code>images/PolinRider-banner-image-smaller.jpg</code>), added on 7 March 2026 by the account
        6mile and carrying the OpenSourceMalware logo. It shows a flaming skeleton in a peaked officer's cap with a red
        star badge, riding a glowing, burning horse that breathes green fire onto burning GitHub repository windows,
        under the title "PolinRider: DPRK GitHub Attack". Who drew it is not stated.
      </p>
      <p>
        The repository has no licence, so the image is all rights reserved. It was used here as inspiration only:
        nothing is traced, its composition is not copied, and none of these marks carries a star, flag or emblem.
      </p>
    </section>
  </div>

  <section class="wrap logos" aria-label="Logo marks">
    <ul>
      {marks.map((m) => (
        <li>
          <p class="mark-name">{m.id}. {m.name}</p>
          <p class="mark-note">{m.rationale}</p>
          {m.variants.map(([label, svg]) => (
            <div class="variant">
              {label && <p class="variant-label">{label}</p>}
              <div class="panels">
                {['light', 'dark'].map((t) => (
                  <div class:list={['panel', t]}>
                    <div class="row">
                      <span class="row-label">Two-tone</span>
                      <div class="sizes">
                        {[16, 32, 64].map((px) => (
                          <span class="size">
                            <svg viewBox="0 0 256 256" width={px} height={px} aria-hidden="true" set:html={svg} />
                            <small>{px}</small>
                          </span>
                        ))}
                      </div>
                      <div class="lockup">
                        <svg viewBox="0 0 256 256" width="30" height="30" aria-hidden="true" set:html={svg} />
                        <span>polinrider</span>
                      </div>
                    </div>
                    <div class="row mono">
                      <span class="row-label">One colour</span>
                      <div class="sizes">
                        {[16, 32, 64].map((px) => (
                          <span class="size">
                            <svg viewBox="0 0 256 256" width={px} height={px} aria-hidden="true" set:html={svg} />
                            <small>{px}</small>
                          </span>
                        ))}
                      </div>
                      <span class="tab">
                        <svg viewBox="0 0 256 256" width="16" height="16" aria-hidden="true" set:html={svg} />
                        PolinRider malware scanner…
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .intro {
    padding-top: 2.5rem;
  }
  .intro h1 {
    margin: 0;
    font-size: var(--text-h1);
  }
  .source {
    max-width: 52rem;
    margin-top: 2rem;
    padding: 1.25rem 1.4rem;
    border: 1px solid var(--pr-border);
    border-radius: var(--pr-radius);
    background: var(--pr-surface);
    font-size: 1rem;
  }
  .source h2 {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
  }
  .source p {
    margin: 0.6rem 0 0;
  }
  .source code {
    font-size: 0.85em;
    overflow-wrap: anywhere;
  }
  .logos {
    margin-top: 2.5rem;
  }
  .logos ul {
    display: grid;
    gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mark-name {
    margin: 0;
    color: var(--pr-heading);
    font-size: 1.125rem;
    font-weight: 650;
  }
  .mark-note {
    margin: 0.2rem 0 0.75rem;
    color: var(--pr-muted);
    font-size: var(--text-sm);
  }
  .variant + .variant {
    margin-top: 1rem;
  }
  .variant-label {
    margin: 0 0 0.4rem;
    color: var(--pr-text);
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .panels {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 50rem) {
    .panels {
      grid-template-columns: 1fr 1fr;
    }
  }
  /* Each panel fixes its own colours, so both themes show side by side. */
  .panel {
    display: grid;
    gap: 1rem;
    padding: 1.25rem 1.4rem;
    border-radius: var(--pr-radius);
  }
  .panel.light {
    border: 1px solid #e4e6eb;
    background: #ffffff;
    --bgc: #ffffff;
    --ink: #0f1220;
    --acc: #0b6a80;
    --word: #0f1220;
    --muted: #5f6573;
    --tab: #f5f6f8;
  }
  .panel.dark {
    border: 1px solid #262c38;
    background: #0c0f15;
    --bgc: #0c0f15;
    --ink: #f4f6fa;
    --acc: #7adcea;
    --word: #f4f6fa;
    --muted: #959dac;
    --tab: #141821;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }
  .row.mono {
    --acc: var(--ink);
    padding-top: 1rem;
    border-top: 1px solid var(--tab);
  }
  .row-label {
    width: 5.5rem;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .sizes {
    display: flex;
    align-items: flex-end;
    gap: 1rem;
  }
  .size {
    display: grid;
    justify-items: center;
    gap: 0.3rem;
  }
  .size small {
    color: var(--muted);
    font-size: 0.6875rem;
  }
  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .lockup span {
    color: var(--word);
    font-size: 1.125rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  .tab {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.8rem;
    border-radius: 8px 8px 0 0;
    background: var(--tab);
    color: var(--word);
    font-size: 0.75rem;
  }
  .tab svg {
    --bgc: var(--tab);
  }
</style>
