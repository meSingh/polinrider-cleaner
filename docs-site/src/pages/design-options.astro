---
// Design options for Mandeep to choose from: three heroes and five logo
// marks. Not linked from anywhere, not indexed (noindex, left out of the
// sitemap and of search). Delete the page once he has chosen.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const checks = [
  { icon: 'computer', label: 'Check my computer', note: 'macOS · Linux · Windows' },
  { icon: 'user', label: 'Check my GitHub account' },
  { icon: 'org', label: 'Check my GitHub organisation' },
] as const;

// Each carries the words people search with: PolinRider, malware, scan or
// check, clean up or remove; computer, GitHub account, organisation.
const heroes = [
  {
    id: 'A',
    pill: 'PolinRider malware scanner and cleaner',
    before: 'Scan for PolinRider.',
    accent: 'Clean it up safely.',
    after: '',
    sub: 'Check your computer, your GitHub account or a whole organisation for PolinRider malware, then remove it. Free, open source, and nothing changes until you type yes.',
  },
  {
    id: 'B',
    pill: 'Free PolinRider malware scanner',
    before: 'Is PolinRider on your computer?',
    accent: 'Find out in minutes.',
    after: '',
    sub: 'One open source program checks your computer, your GitHub account and your organisation for PolinRider malware, and helps you remove it safely.',
  },
  {
    id: 'C',
    pill: 'For developers hit by PolinRider',
    before: 'Find PolinRider malware.',
    accent: 'Remove it in the right order.',
    after: '',
    sub: 'Scan your computer, your GitHub account or your organisation, then clean up step by step: computer, passwords, repositories. Read-only until you say yes.',
  },
];

// Original marks, drawn on a 32-unit grid in one colour (currentColor), with
// strokes thick enough to survive 16px.
const marks = [
  {
    id: '1',
    name: 'Shield and scan line',
    note: 'Protection, with the sweep of a scan across it.',
    svg: '<path d="M16 3.5 26 7.5v7.8c0 6.2-4.1 11.2-10 13.2-5.9-2-10-7-10-13.2V7.5Z" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linejoin="round"/><path d="M9.5 16h13" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"/><circle cx="16" cy="16" r="2.4" fill="currentColor"/>',
  },
  {
    id: '2',
    name: 'Magnifier over a commit graph',
    note: 'Looking into the history of a repository.',
    svg: '<circle cx="13.5" cy="13.5" r="9.5" fill="none" stroke="currentColor" stroke-width="2.8"/><path d="m20.6 20.6 7 7" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"/><path d="M9.5 16.5 13.5 10.5l4 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9.5" cy="16.5" r="1.9" fill="currentColor"/><circle cx="13.5" cy="10.5" r="1.9" fill="currentColor"/><circle cx="17.5" cy="16.5" r="1.9" fill="currentColor"/>',
  },
  {
    id: '3',
    name: 'A branch node, ringed',
    note: 'One commit on a branch, found and held.',
    svg: '<path d="M10 4.5v23" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"/><path d="M10 22c0-6 4-8.5 8-9.6" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"/><circle cx="22.5" cy="11.5" r="6" fill="none" stroke="currentColor" stroke-width="2.8"/><circle cx="22.5" cy="11.5" r="2.2" fill="currentColor"/>',
  },
  {
    id: '4',
    name: 'Monogram P',
    note: 'A P whose stem is a branch with a commit at its foot.',
    svg: '<path d="M10.5 26V6h7a7 7 0 0 1 0 14h-7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><circle cx="10.5" cy="26.5" r="3" fill="currentColor"/>',
  },
  {
    id: '5',
    name: 'Radar sweep',
    note: 'A scan moving round, with a point it has found.',
    svg: '<circle cx="16" cy="16" r="12" fill="none" stroke="currentColor" stroke-width="2.6"/><path d="M16 16 26.4 10a12 12 0 0 0-10.4-6Z" fill="currentColor" opacity="0.35"/><path d="M16 16 26.4 10" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/><circle cx="16" cy="16" r="2.3" fill="currentColor"/><circle cx="10.5" cy="20" r="1.9" fill="currentColor"/>',
  },
  {
    id: 'now',
    name: 'Today\'s mark, for comparison',
    note: 'The ring and scan line in public/favicon.svg.',
    svg: '<circle cx="16" cy="16" r="11" fill="none" stroke="currentColor" stroke-width="3"/><path d="M3 16h26" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><circle cx="16" cy="16" r="3.2" fill="currentColor"/>',
  },
];
---

<Base title="Design options" description="Hero and logo options for review." noindex hasCanonical={false}>
  <div class="wrap intro">
    <p class="eyebrow">For Mandeep</p>
    <h1>Design options</h1>
    <p>Three heroes and five logo marks. Pick one of each. This page is not linked anywhere and is not indexed.</p>
  </div>

  {heroes.map((h) => (
    <section class="opt-hero" aria-label={`Hero option ${h.id}`}>
      <p class="opt-label wrap">Hero option {h.id}</p>
      <div class="hero">
        <p class="badge"><span class="dot" aria-hidden="true"></span>{h.pill}</p>
        <h2 class="h1">{h.before}<br /><span class="accent">{h.accent}</span>{h.after}</h2>
        <p class="tagline">{h.sub}</p>
        <div class="checks">
          {checks.map((c, i) => (
            <a class:list={['check', { primary: i === 0 }]} href={`${base}/#how`}>
              <Icon name={c.icon} size={20} />
              <span>{c.label}{'note' in c && <small>{c.note}</small>}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="wrap logos" aria-labelledby="logos-h">
    <h2 id="logos-h">Logo marks</h2>
    <p>Each in one colour, at 16, 32 and 64px, beside the wordmark, on light and on dark.</p>
    <ul>
      {marks.map((m) => (
        <li>
          <p class="mark-name">{m.id === 'now' ? '' : `Mark ${m.id}: `}{m.name}</p>
          <p class="mark-note">{m.note}</p>
          <div class="panels">
            {['light', 'dark'].map((t) => (
              <div class:list={['panel', t]}>
                <div class="sizes">
                  {[16, 32, 64].map((px) => (
                    <span class="size">
                      <svg viewBox="0 0 32 32" width={px} height={px} aria-hidden="true" set:html={m.svg} />
                      <small>{px}</small>
                    </span>
                  ))}
                </div>
                <div class="lockup">
                  <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" set:html={m.svg} />
                  <span>polinrider</span>
                </div>
                <div class="favicon">
                  <span class="tab">
                    <svg viewBox="0 0 32 32" width="16" height="16" aria-hidden="true" set:html={m.svg} />
                    PolinRider scanner…
                  </span>
                </div>
              </div>
            ))}
          </div>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .intro {
    padding-top: 2.5rem;
  }
  .intro h1 {
    margin: 0;
    font-size: var(--text-h1);
  }
  .opt-hero {
    margin-top: 3rem;
    border-block: 1px solid var(--pr-border);
  }
  .opt-label {
    margin: 0;
    padding-block: 0.6rem;
    color: var(--pr-muted);
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(2.5rem, 7vw, 4.5rem) var(--gutter) clamp(2.5rem, 6vw, 4rem);
    overflow: hidden;
    text-align: center;
  }
  .hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: 0;
    left: 50%;
    width: min(60rem, 120vw);
    height: 28rem;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at 50% 35%, var(--pr-glow), transparent 65%);
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.5rem;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--pr-accent);
    border-radius: 999px;
    background: var(--pr-bg);
    color: var(--pr-accent);
    font-size: var(--text-xs);
    font-weight: 650;
  }
  .dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--pr-accent);
  }
  .h1 {
    max-width: 20ch;
    margin: 0;
    font-size: clamp(2.25rem, 1.2rem + 4.2vw, 4rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
  }
  .accent {
    color: var(--pr-accent);
  }
  .tagline {
    max-width: 40rem;
    margin: 1.25rem 0 0;
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    line-height: 1.55;
    text-wrap: balance;
  }
  .checks {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .check {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1.3rem;
    border: 1px solid var(--pr-border-strong);
    border-radius: 999px;
    background: var(--pr-bg);
    color: var(--pr-heading);
    font-size: 1rem;
    font-weight: 600;
    text-align: start;
    text-decoration: none;
  }
  .check.primary {
    border-color: var(--pr-pill-bg);
    background: var(--pr-pill-bg);
    color: var(--pr-pill-text);
  }
  .check small {
    display: block;
    font-size: 0.75rem;
    font-weight: 500;
    opacity: 0.8;
  }

  .logos {
    margin-top: 4rem;
  }
  .logos h2 {
    margin: 0 0 0.5rem;
    font-size: var(--text-h2);
  }
  .logos ul {
    display: grid;
    gap: 2rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }
  .mark-name {
    margin: 0;
    color: var(--pr-heading);
    font-weight: 650;
  }
  .mark-note {
    margin: 0.2rem 0 0.75rem;
    color: var(--pr-muted);
    font-size: var(--text-sm);
  }
  .panels {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 50rem) {
    .panels {
      grid-template-columns: 1fr 1fr;
    }
  }
  /* Each panel fixes its own colours, so both themes show side by side. */
  .panel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    padding: 1.25rem 1.4rem;
    border-radius: var(--pr-radius);
  }
  .panel.light {
    border: 1px solid #e4e6eb;
    background: #ffffff;
    color: #0b6a80;
    --word: #0f1220;
    --muted: #5f6573;
    --tab: #f5f6f8;
  }
  .panel.dark {
    border: 1px solid #262c38;
    background: #0c0f15;
    color: #7adcea;
    --word: #f4f6fa;
    --muted: #959dac;
    --tab: #141821;
  }
  .sizes {
    display: flex;
    align-items: flex-end;
    gap: 1rem;
  }
  .size {
    display: grid;
    justify-items: center;
    gap: 0.3rem;
  }
  .size small {
    color: var(--muted);
    font-size: 0.6875rem;
  }
  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .lockup span {
    color: var(--word);
    font-size: 1.125rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  .tab {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.75rem;
    border-radius: 8px 8px 0 0;
    background: var(--tab);
    color: var(--word);
    font-size: 0.75rem;
  }
  .tab svg {
    color: inherit;
  }
</style>
