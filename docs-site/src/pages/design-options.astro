<Base title="Design options" description="Headline and logo options for review." noindex hasCanonical={false}>
  <div class="wrap intro">
    <p class="eyebrow">For Mandeep</p>
    <h1>Design options</h1>
    <p>Eight headlines and six logo marks. Pick one of each. This page is not linked anywhere and is not indexed.</p>
  </div>

  {heroes.map((h) => (
    <section class="opt-hero" aria-label={`Headline option ${h.id}`}>
      <p class="opt-label wrap">Headline {h.id} · {h.angle}</p>
      <div class="hero">
        <p class="badge"><span class="dot" aria-hidden="true"></span>{pill}</p>
        <h2 class="h1">{h.before}<br /><span class="accent">{h.accent}</span></h2>
        <p class="tagline">{sub}</p>
        <div class="checks">
          {checks.map((c, i) => (
            <a class:list={['check', { primary: i === 0 }]} href={`${base}/#how`}>
              <Icon name={c.icon} size={20} />
              <span>{c.label}{'note' in c && <small>{c.note}</small>}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="wrap logos" aria-labelledby="logos-h">
    <h2 id="logos-h">Logo marks</h2>
    <p>
      Each in two tones (the mark in ink, one part in the brand colour) and in one colour, at 16, 32 and 64px, beside
