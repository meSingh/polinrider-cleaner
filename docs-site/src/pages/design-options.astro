---
// Logo options, round 7, for Mandeep: marks in the spirit of the image most
// often shown for PolinRider (a skeleton riding a horse, in an officer's
// cap), drawn from the defender's side so ours never reads as the
// malware's own mascot. Original geometry only; the source image was used
// for inspiration and nothing in it is traced or copied. No national
// insignia; the caps are generic peaked caps, each shown with and without.
// Not linked, noindex, out of the sitemap and search. Delete once chosen.
import Base from '../layouts/Base.astro';

// --ink is the mark, --acc the brand colour for the two-tone form, --bgc the
// background (the halo where two shapes cross).
const marks = [{"id": "A", "name": "Struck", "rationale": "The rider's skull with one stroke through it: PolinRider, removed.", "variants": [["With cap", "<path fill=\"var(--ink)\" fill-rule=\"evenodd\" d=\"M80.0 166.0A60.0 60.0 0 1 1 176.0 166.0L162.0 184.0V210.0Q162.0 220.0 152.0 220.0H104.0Q94.0 220.0 94.0 210.0V184.0ZM91.0 144.0a15.0 15.0 0 1 0 30.0 0a15.0 15.0 0 1 0 -30.0 0ZM135.0 144.0a15.0 15.0 0 1 0 30.0 0a15.0 15.0 0 1 0 -30.0 0ZM128.0 164.0L121.0 178.0H135.0ZM110.0 192.0h6.0v20.0h-6.0ZM125.0 192.0h6.0v20.0h-6.0ZM140.0 192.0h6.0v20.0h-6.0Z\"/><path fill=\"var(--ink)\" d=\"M42.0 62.0Q128.0 26.0 214.0 62.0L196.0 76.0H60.0ZM64.0 81.0H192.0V92.0H64.0ZM56.0 97.0H200.0Q174.0 116.0 128.0 118.0Q82.0 116.0 56.0 97.0Z\"/><path d=\"M36 220 220 36\" stroke=\"var(--bgc)\" stroke-width=\"46\" stroke-linecap=\"round\"/><path d=\"M36 220 220 36\" stroke=\"var(--acc)\" stroke-width=\"22\" stroke-linecap=\"round\" data-accent=\"1\"/>"], ["Without cap", "<path fill=\"var(--ink)\" fill-rule=\"evenodd\" d=\"M80.0 166.0A60.0 60.0 0 1 1 176.0 166.0L162.0 184.0V210.0Q162.0 220.0 152.0 220.0H104.0Q94.0 220.0 94.0 210.0V184.0ZM91.0 144.0a15.0 15.0 0 1 0 30.0 0a15.0 15.0 0 1 0 -30.0 0ZM135.0 144.0a15.0 15.0 0 1 0 30.0 0a15.0 15.0 0 1 0 -30.0 0ZM128.0 164.0L121.0 178.0H135.0ZM110.0 192.0h6.0v20.0h-6.0ZM125.0 192.0h6.0v20.0h-6.0ZM140.0 192.0h6.0v20.0h-6.0Z\"/><path d=\"M36 220 220 36\" stroke=\"var(--bgc)\" stroke-width=\"46\" stroke-linecap=\"round\"/><path d=\"M36 220 220 36\" stroke=\"var(--acc)\" stroke-width=\"22\" stroke-linecap=\"round\" data-accent=\"1\"/>"]]}, {"id": "B", "name": "Horse skull, found", "rationale": "The horse's skull caught inside the scanner's frame. At small sizes it can read as any animal's skull.", "variants": [["", "<path fill=\"var(--ink)\" fill-rule=\"evenodd\" d=\"M52 112C52 78 86 58 120 62C150 66 170 82 196 94L224 108C234 114 232 128 220 130L150 132C120 150 82 152 62 138C55 132 52 122 52 112ZM88.0 100.0a16.0 16.0 0 1 0 32.0 0a16.0 16.0 0 1 0 -32.0 0ZM2