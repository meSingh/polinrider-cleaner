---
// Reference pages under What is PolinRider?: today, the full indicator set.
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { citations } from '../../schema';
import { firstCommitDay } from '../../sources.mjs';

export async function getStaticPaths() {
  return (await getCollection('threat'))
    .filter((e) => e.id !== 'index')
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Article
  title={entry.data.title}
  description={entry.data.description}
  crumbs={[{ label: 'What is PolinRider?', href: `${base}/what-is-polinrider/` }]}
  headings={headings}
  section="What is PolinRider?"
  file={entry.filePath}
  published={firstCommitDay(entry.filePath)}
  citations={citations(entry.body)}
>
  <Content />
</Article>
