---
// One of our News posts. The line under the title is its date and, when the
// post came from one, the indicator review behind it.
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { longDate } from '../../releaseDate';
import { abs, citations, faqPage } from '../../schema';
import { falseAlarmFaq } from '../../faq';
import { ogImage } from '../../og';

export async function getStaticPaths() {
  return (await getCollection('news')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { date, review } = entry.data;
// The posts with a questions section carry it as FAQPage data too.
const faqs: Record<string, typeof falseAlarmFaq> = { '2026-11-04-polinrider-or-false-alarm': falseAlarmFaq };
const faq = faqs[entry.id];
---

<Article
  title={entry.data.title}
  description={entry.data.description}
  crumbs={[{ label: 'News', href: `${base}/news/` }]}
  headings={headings}
  section="News"
  file={entry.filePath}
  foot={false}
  image={ogImage(`news/${entry.id}`, `${entry.data.title}. ${entry.data.description}`)}
  schemaType="NewsArticle"
  published={date}
  citations={citations(entry.body)}
  extraSchema={faq ? [faqPage(abs(Astro.url.pathname), faq)] : []}
>
  <Fragment slot="meta">
    <time datetime={date}>{longDate(date)}</time>
    {review && (
      <>
        {' · From the '}
        <a href={`${base}/news/indicator-reviews/${review}/`}>indicator review of {longDate(review)}</a>
      </>
    )}
  </Fragment>
  <Content />
  <p slot="after" class="back"><a href={`${base}/news/`}>All news</a></p>
</Article>

<style>
  .back {
    margin-top: 3rem;
    font-size: var(--text-sm);
  }
</style>
