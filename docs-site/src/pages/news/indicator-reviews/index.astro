---
// How the weekly reviews work, and every review in a table that gains a
// row each week (src/content/indicator-reviews/index.md).
import { getEntry, render } from 'astro:content';
import Article from '../../../layouts/Article.astro';
import { reviews } from '../../../news';

const entry = (await getEntry('reviews', 'index'))!;
const { Content, headings } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = await reviews();
---

<Article
  title={entry.data.title}
  description={entry.data.description}
  crumbs={[{ label: 'News', href: `${base}/news/` }]}
  headings={headings}
  section="Indicator review"
  file={entry.filePath}
  side={{
    title: 'Indicator reviews',
    items: [
      { label: 'All reviews', href: `${base}/news/indicator-reviews/` },
      ...all.map((r, i) => ({ label: r.label, href: r.href, badge: i === 0 ? 'latest' : undefined })),
    ],
  }}
>
  <Content />
</Article>
