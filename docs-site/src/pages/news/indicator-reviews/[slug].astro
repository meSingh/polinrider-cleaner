---
// One weekly indicator review. The text is never edited after it merges;
// only the page around it changes.
import { getCollection, render } from 'astro:content';
import Article from '../../../layouts/Article.astro';
import { humanDates, reviews } from '../../../news';

export async function getStaticPaths() {
  return (await getCollection('reviews'))
    .filter((e) => e.id !== 'index')
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = await reviews();
const day = entry.id.slice(0, 10);
// Reviews written before they carried a description get one here, since
// past reviews are never edited.
const description =
  entry.data.description ??
  `Weekly PolinRider indicator review for ${day}: what changed in the indicator set and why.`;
---

<Article
  title={humanDates(entry.data.title)}
  description={description}
  crumbs={[
    { label: 'News', href: `${base}/news/` },
    { label: 'Indicator reviews', href: `${base}/news/indicator-reviews/` },
  ]}
  headings={headings}
  section="Indicator review"
  file={entry.filePath}
  side={{
    title: 'Indicator reviews',
    items: [
      { label: 'All reviews', href: `${base}/news/indicator-reviews/` },
      ...all.map((r, i) => ({ label: r.label, href: r.href, badge: i === 0 ? 'latest' : undefined })),
    ],
  }}
>
  <Content />
</Article>
