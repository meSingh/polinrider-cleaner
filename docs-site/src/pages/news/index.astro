---
// News: everything about PolinRider in one line of time, newest first. Our
// posts, the weekly indicator reviews and articles published elsewhere sit
// together; only an outside article is marked, by its publisher's name and
// an icon, because it opens on another site.
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Icon from '../../components/Icon.astro';
import NewsTimeline from '../../components/NewsTimeline.astro';
import { timeline } from '../../news';
import { abs, breadcrumbs } from '../../schema';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const items = await timeline();
---

<Base
  title="PolinRider news"
  description="Everything about the PolinRider supply-chain malware, newest first: what changed, the weekly indicator reviews and what others have published."
  type="website"
  schema={[breadcrumbs([], 'News', abs(Astro.url.pathname))]}
>
  <div class="wrap page">
    <Crumbs items={[]} />
    <div class="head">
      <div>
        <h1>News</h1>
        <p class="lead">Everything about PolinRider, newest first.</p>
      </div>
      <a class="rss" href={`${base}/news/rss.xml`}><Icon name="rss" size={17} /> RSS</a>
    </div>
    <p class="how">
      The indicator set is checked against published sources every week, and every week is listed here.{' '}
      <a href={`${base}/news/indicator-reviews/`}>How the weekly reviews work</a>
    </p>
    <NewsTimeline items={items} months />
  </div>
</Base>

<style>
  .page {
    max-width: calc(56rem + 2 * var(--gutter));
    padding-top: 2.5rem;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }
  h1 {
    margin: 0.75rem 0 0;
    font-size: var(--text-h1);
  }
  .lead {
    margin: 0.75rem 0 0;
    font-size: 1.1875rem;
  }
  .rss {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .how {
    margin: 1rem 0 2.5rem;
    color: var(--pr-muted);
    font-size: var(--text-sm);
  }
</style>
