---
// The home page's opening screen. It has one job: tell a worried reader what
// this is and what to do, in a few words. A small badge, a two-line title, one
// sentence, one button and one link. Only the home page has a hero.
//
// Front matter: hero.title (may hold <br />), hero.tagline and hero.actions.
// The first action is the button, the second the text link.
import { Icon } from '@astrojs/starlight/components';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const [primary, secondary] = actions;
---

<div class="pr-hero">
  <p class="badge"><span class="dot" aria-hidden="true"></span>Free and open source. macOS, Linux and Windows.</p>
  <h1 id="_top" set:html={title} />
  {tagline && <p class="tagline" set:html={tagline} />}
  <div class="actions">
    {primary && <a class="pr-cta" href={primary.link}>{primary.text}</a>}
    {secondary && (
      <a class="pr-textlink" href={secondary.link}>
        {secondary.text}
        <Icon name="right-arrow" size="1.1rem" />
      </a>
    )}
  </div>
</div>

<style>
  .pr-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: clamp(2.5rem, 7vw, 5rem) 1rem;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.75rem;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--pr-border);
    border-radius: 999px;
    color: var(--pr-text);
    font-size: 0.875rem;
  }
  .dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--pr-accent);
  }
  h1 {
    margin: 0;
    max-width: 18ch;
    color: var(--pr-heading);
    font-size: clamp(2.25rem, 1.2rem + 4.2vw, 4rem);
    font-weight: 650;
    line-height: 1.06;
    letter-spacing: -0.035em;
  }
  .tagline {
    max-width: 36rem;
    margin: 1.25rem 0 0;
    color: var(--pr-text);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.3125rem);
    line-height: 1.5;
    text-wrap: balance;
  }
  .tagline :global(code) {
    padding: 0.05em 0.35em;
    border: 1px solid var(--pr-border);
    border-radius: 6px;
    background: var(--pr-surface);
    color: var(--pr-heading);
    font-size: 0.9em;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 1.75rem;
    margin-top: 2rem;
  }
  .pr-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.6rem;
    border-radius: 999px;
    background: var(--pr-pill-bg);
    color: var(--pr-pill-text);
    font-size: 1.0625rem;
    font-weight: 600;
    text-decoration: none;
  }
  .pr-cta:hover {
    opacity: 0.88;
  }
  .pr-textlink {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--pr-heading);
    font-size: 1.0625rem;
    font-weight: 600;
    text-decoration: none;
  }
  .pr-textlink:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  .pr-cta:focus-visible,
  .pr-textlink:focus-visible {
    outline: 2px solid var(--pr-accent);
    outline-offset: 3px;
  }
</style>
