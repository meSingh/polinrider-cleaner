---
// Light, dark or follow the system, as three small buttons instead of
// Starlight's drop-down, so the current choice is visible without opening
// anything. "System" is the default. It keeps Starlight's own storage key and
// the same rules, so Starlight's early theme script (which runs before the
// page paints) still picks the right theme.
import { Icon } from '@astrojs/starlight/components';

const options = [
  { value: 'auto', label: 'Follow the system', icon: 'laptop' },
  { value: 'light', label: 'Light', icon: 'sun' },
  { value: 'dark', label: 'Dark', icon: 'moon' },
] as const;
---

<pr-theme-toggle>
  <div class="toggle" role="group" aria-label="Colour theme">
    {options.map((o) => (
      <button type="button" data-theme-value={o.value} aria-pressed={o.value === 'auto' ? 'true' : 'false'} title={o.label}>
        <Icon name={o.icon} size="1rem" />
        <span class="sr-only">{o.label}</span>
      </button>
    ))}
  </div>
</pr-theme-toggle>

{/* Marks the stored choice before the page paints, so the toggle never flickers. */}
<script is:inline>
  (() => {
    const t = (typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme')) || 'auto';
    document.querySelectorAll('pr-theme-toggle button').forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.themeValue === t));
    });
  })();
</script>

<script>
  type Theme = 'auto' | 'dark' | 'light';
  const key = 'starlight-theme';
  const parse = (t: unknown): Theme => (t === 'light' || t === 'dark' ? t : 'auto');
  const load = (): Theme => {
    try {
      return parse(localStorage.getItem(key));
    } catch {
      return 'auto';
    }
  };
  const system = (): 'light' | 'dark' =>
    matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

  function apply(theme: Theme) {
    document.documentElement.dataset.theme = theme === 'auto' ? system() : theme;
    document.querySelectorAll<HTMLButtonElement>('pr-theme-toggle button').forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.themeValue === theme));
    });
    try {
      localStorage.setItem(key, theme === 'auto' ? '' : theme);
    } catch {
      /* Private windows can refuse storage; the choice then lasts this page. */
    }
  }

  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (load() === 'auto') apply('auto');
  });

  class ThemeToggle extends HTMLElement {
    connectedCallback() {
      this.querySelectorAll<HTMLButtonElement>('button').forEach((b) =>
        b.addEventListener('click', () => apply(parse(b.dataset.themeValue))),
      );
    }
  }
  customElements.define('pr-theme-toggle', ThemeToggle);
  apply(load());
</script>

<style>
  .toggle {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--pr-border);
    border-radius: 999px;
    background: var(--pr-bg);
  }
  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.875rem;
    height: 1.875rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--pr-muted);
    cursor: pointer;
  }
  button:hover {
    color: var(--pr-heading);
  }
  button[aria-pressed='true'] {
    background: var(--pr-surface);
    color: var(--pr-heading);
    box-shadow: inset 0 0 0 1px var(--pr-border-strong);
  }
  button:focus-visible {
    outline: 2px solid var(--pr-accent);
    outline-offset: 1px;
  }
</style>
