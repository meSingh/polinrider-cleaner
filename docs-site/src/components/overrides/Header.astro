---
// The top bar. Starlight's own header has the title, search and settings but
// no links, and the design wants a few plain links and one obvious button:
// "Download", which goes to the quick start, where the download is verified.
// The links hide on narrow screens, where the sidebar menu carries them; the
// theme toggle stays, because the home page has no menu.
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { Icon } from '@astrojs/starlight/components';
import { REPO_URL } from '../../siteConfig.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { label: 'Guides', href: `${base}/guides/order/`, match: '/guides/' },
  { label: 'The campaign', href: `${base}/campaign/what-it-is/`, match: '/campaign/' },
  { label: 'News', href: `${base}/news/`, match: '/news/' },
  { label: 'Releases', href: `${base}/releases/`, match: '/releases/' },
];
const path = Astro.url.pathname;
---

<div class="pr-header">
  <div class="pr-title"><SiteTitle /></div>

  <nav class="pr-nav" aria-label="Main">
    {links.map((l) => (
      <a href={l.href} aria-current={path.includes(l.match) ? 'page' : undefined}>{l.label}</a>
    ))}
  </nav>

  <div class="pr-tools print:hidden">
    <Search />
    <ThemeSelect />
    <a class="pr-gh" href={REPO_URL}>
      <Icon name="github" size="1.25rem" />
      <span class="sr-only">polinrider-cleaner on GitHub</span>
    </a>
    <a class="pr-pill" href={`${base}/quick-start/`}>Download</a>
  </div>
</div>

<style>
  .pr-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
  }
  .pr-title {
    min-width: 0;
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
  }
  .pr-nav {
    display: none;
    gap: 1.75rem;
    margin-inline-start: 1.5rem;
  }
  .pr-nav a {
    color: var(--pr-text);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }
  .pr-nav a:hover,
  .pr-nav a[aria-current='page'] {
    color: var(--pr-heading);
  }
  .pr-nav a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.45em;
    text-decoration-thickness: 2px;
  }
  .pr-tools {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-inline-start: auto;
  }
  .pr-gh {
    display: none;
    color: var(--pr-text);
    padding: 0.4rem;
  }
  .pr-gh:hover {
    color: var(--pr-heading);
  }
  .pr-pill {
    display: none;
    align-items: center;
    padding: 0.5rem 1.05rem;
    border-radius: 999px;
    background: var(--pr-pill-bg);
    color: var(--pr-pill-text);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .pr-pill:hover {
    opacity: 0.88;
  }
  @media (min-width: 50rem) {
    .pr-gh,
    .pr-pill {
      display: inline-flex;
    }
  }
  @media (min-width: 72rem) {
    .pr-nav {
      display: flex;
    }
  }
</style>
