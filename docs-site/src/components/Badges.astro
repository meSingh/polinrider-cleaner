---
// The trust badges as small native chips (src/badges.ts). A live check that
// passed shows a green dot and its word; everything else is neutral.
import { badges } from '../badges';

interface Props {
  /** md in the footer, lg where the badges are the point. */
  size?: 'md' | 'lg';
  /** Labels to leave out here, such as License. */
  exclude?: string[];
  center?: boolean;
}
const { size = 'md', exclude = [], center = false } = Astro.props;
const list = (await badges()).filter((b) => !exclude.includes(b.label));
---

<ul class:list={['badges', size, { center }]}>
  {list.map((b) => {
    const inner = (
      <>
        {b.live && <span class:list={['dot', b.tone]} aria-hidden="true" />}
        <span class="label">{b.label}</span>
        <span class="value">{b.value}</span>
      </>
    );
    return <li>{b.href ? <a class="chip" href={b.href}>{inner}</a> : <span class="chip">{inner}</span>}</li>;
  })}
</ul>

<style>
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--pr-border);
    border-radius: 999px;
    background: var(--pr-bg);
    color: var(--pr-text);
    font-size: 0.8125rem;
    line-height: 1.4;
    text-decoration: none;
    white-space: nowrap;
  }
  a.chip:hover {
    border-color: var(--pr-border-strong);
    color: var(--pr-heading);
  }
  .label {
    color: var(--pr-muted);
  }
  .value {
    color: var(--pr-heading);
    font-weight: 650;
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--pr-muted);
  }
  .dot.good {
    background: var(--pr-clean);
  }
  .center {
    justify-content: center;
  }
  .md .chip {
    padding: 0.35rem 0.85rem;
    font-size: 0.875rem;
  }
  .lg {
    gap: 0.65rem;
  }
  .lg .chip {
    gap: 0.55rem;
    padding: 0.55rem 1.1rem;
    font-size: 1rem;
  }
  .lg .dot {
    width: 0.6rem;
    height: 0.6rem;
  }
</style>
