---
// Updates as one line of time, newest first, optionally under month
// headings. Three kinds that look different on purpose:
//   update   our articles: label, title, one line and a reading time; the
//            main weight of the page;
//   review   a weekly indicator review: one compact line, the outcome;
//   reading  worth reading elsewhere: label with the publisher, title and
//            a sentence on why it matters; opens in a new tab.
// Each entry carries data-kind, so the Updates page can filter them.
import type { TimelineItem } from '../news';

interface Props {
  items: TimelineItem[];
  months?: boolean;
}
const { items, months = false } = Astro.props;

const month = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const day = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });

const groups: { label: string; items: TimelineItem[] }[] = [];
for (const i of items) {
  const label = months ? month(i.date) : '';
  if (!groups.length || groups[groups.length - 1].label !== label) groups.push({ label, items: [] });
  groups[groups.length - 1].items.push(i);
}
---

<div class="updates-timeline">
  {
    groups.map((g) => (
      <section class="group">
        {g.label && <h2 class="month">{g.label}</h2>}
        <ol>
          {g.items.map((i) => (
            <li class:list={['item', i.kind]} data-kind={i.kind}>
              <time datetime={i.date}>{day(i.date)}</time>
              {i.kind === 'review' ? (
                <a class="review-line" href={i.href}>
                  <span class="kicker">Indicator review</span>
                  <span>{i.title} <span aria-hidden="true">→</span></span>
                </a>
              ) : (
                <div class="entry">
                  <p class="kicker">
                    {i.kind === 'update' ? 'Update' : <>Worth reading · {i.source} <span aria-hidden="true">↗</span></>}
                  </p>
                  <h3 class="title">
                    <a href={i.href}>{i.title}</a>
                  </h3>
                  {i.summary && <p class="summary" set:html={i.summary} />}
                  {i.minutes && <p class="read">{i.minutes} min read</p>}
                </div>
              )}
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .month {
    margin: 2rem 0 0.25rem;
    color: var(--pr-muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .group:first-child .month {
    margin-top: 0.5rem;
  }
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .item {
    display: grid;
    grid-template-columns: 4.25rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--pr-border);
  }
  time {
    padding-top: 0.15rem;
    color: var(--pr-muted);
    font-size: var(--text-sm);
    white-space: nowrap;
  }
  .kicker {
    margin: 0;
    color: var(--pr-accent);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .reading .kicker {
    color: var(--pr-muted);
  }
  .title {
    margin: 0.3rem 0 0;
    font-size: 1.1875rem;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  .title a {
    color: var(--pr-heading);
    text-decoration: none;
  }
  .title a:hover {
    text-decoration: underline;
  }
  .reading .title {
    font-size: 1.0625rem;
    font-weight: 600;
  }
  .summary {
    margin: 0.35rem 0 0;
    color: var(--pr-text);
    line-height: 1.55;
  }
  .reading .summary {
    font-size: var(--text-sm);
  }
  .read {
    margin: 0.4rem 0 0;
    color: var(--pr-muted);
    font-size: var(--text-sm);
  }
  /* A review is one quiet line. */
  .review {
    padding: 0.7rem 0;
  }
  .review time {
    padding-top: 0;
  }
  .review-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    color: var(--pr-text);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .review-line:hover span:last-child {
    text-decoration: underline;
  }
  .review .kicker {
    color: var(--pr-muted);
    font-weight: 650;
  }
  .item[hidden],
  .group[hidden] {
    display: none;
  }
  /* On a phone the date sits above the entry, so the text keeps the width. */
  @media (max-width: 36rem) {
    .item {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.2rem;
    }
    .review {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0.75rem;
    }
  }
</style>
