---
// Runs in <head> before anything paints: sets data-theme on <html> from the
// reader's stored choice, light when there is none, so a dark page never
// flashes white and nobody gets dark without asking for it.
---

<script is:inline>
  (() => {
    let t = 'light';
    try {
      // pr-theme is the reader's choice; starlight-theme is where the old
      // site (before November 2026) kept it.
      const saved = localStorage.getItem('pr-theme') ?? localStorage.getItem('starlight-theme');
      if (saved === 'dark') t = 'dark';
    } catch {}
    document.documentElement.dataset.theme = t;
    if (t === 'dark') {
      document.querySelector('meta[name="color-scheme"]')?.setAttribute('content', 'dark');
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#0c0f15');
    }
  })();
</script>
