---
// The line under a News post's title: the day it was published and, when
// the post came from one, a link to the indicator review behind it. Placed
// once at the top of every post; reads the post's own front matter.
import { longDate } from '../releaseDate';
import { newsPost } from '../news';

const post = newsPost(Astro.locals.starlightRoute.entry.id);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{post && (
  <p class="news-meta">
    <time datetime={post.date}>{longDate(post.date)}</time>
    {post.review && (
      <>
        {' · From the '}
        <a href={`${base}/indicator-reviews/${post.review}/`}>indicator review of {longDate(post.review)}</a>
      </>
    )}
  </p>
)}

<style>
  .news-meta { color: var(--muted-foreground); font-size: 0.875rem; margin-top: 0; }
</style>
