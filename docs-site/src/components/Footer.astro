---
// Below every page: who built it and the few links people look for at the
// bottom of a page. The analytics line appears only while Plausible is
// switched on, so the footer never claims analytics the page does not load.
import { PLAUSIBLE_SCRIPT_ID, REPO_URL } from '../siteConfig.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="site-footer no-print">
  <div class="wrap">
    <p>
      Built by <a href="https://github.com/meSingh">Mandeep Singh</a> after cleaning up a real
      PolinRider incident.
      {PLAUSIBLE_SCRIPT_ID && (
        <>
          {' '}Visits are counted with <a href="https://plausible.io/data-policy">Plausible</a>,
          without cookies or personal data.
        </>
      )}
    </p>
    <p class="links">
      <a href={REPO_URL}>GitHub</a>
      <a href={`${base}/news/rss.xml`}>RSS</a>
      <a href={`${base}/docs/project/security/`}>Report a vulnerability</a>
      <a href={`${base}/docs/project/disclaimer/`}>Disclaimer</a>
      <a href={`${base}/third-party-notices.txt`}>Third-party notices</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    padding-block: 2rem 2.5rem;
    border-top: 1px solid var(--pr-border);
    color: var(--pr-muted);
    font-size: var(--text-sm);
  }
  p {
    margin: 0;
  }
  a {
    color: var(--pr-text);
  }
  a:hover {
    color: var(--pr-heading);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 0.75rem;
  }
</style>
