---
// The picture beside the What is PolinRider? intro: a skeleton in a peaked
// cap on a rearing horse, cut out on a transparent ground so it sits
// straight on the grey band in light mode and on the page in dark mode.
// Generated with Google Gemini (credited in /third-party-notices.txt).
// Served as WebP with its transparency, with a PNG for browsers without
// WebP, at 1x and 2x of its displayed width. Decorative: empty alt and
// hidden from assistive technology. Width and height are set and it loads
// eagerly, as it is above the fold, so nothing moves while it arrives.
import { Picture } from 'astro:assets';
import rider from '../assets/polinrider-rider.png';
---

<Picture
  class="hero-pic"
  src={rider}
  alt=""
  aria-hidden="true"
  formats={['webp']}
  fallbackFormat="png"
  quality={78}
  widths={[360, 720]}
  sizes="(min-width: 48rem) 19.5rem, 0px"
  loading="eager"
  decoding="async"
  fetchpriority="high"
/>

<style>
  :global(picture:has(> .hero-pic)) {
    display: block;
  }
  /* A cutout: it sits straight on the band, with no frame of its own. */
  :global(.hero-pic) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
  }
</style>
