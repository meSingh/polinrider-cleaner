---
// The picture beside the What is PolinRider? intro: a skeleton in a peaked
// cap on a rearing horse, on a dark navy ground. Generated with Google
// Gemini (credited in /third-party-notices.txt). Served as WebP, with a PNG
// for browsers without WebP, at 1x and 2x of its displayed width.
// Decorative: empty alt and hidden from assistive technology. Width and
// height are set and it loads eagerly, as it is above the fold, so nothing
// moves while it arrives. Kept small and framed as a card: rounded corners,
// a hairline border and, on the light band, a soft shadow.
import { Picture } from 'astro:assets';
import rider from '../assets/polinrider-rider-card.png';
---

<Picture
  class="hero-pic"
  src={rider}
  alt=""
  aria-hidden="true"
  formats={['webp']}
  fallbackFormat="png"
  quality={78}
  widths={[240, 480]}
  sizes="(min-width: 48rem) 15rem, 0px"
  loading="eager"
  decoding="async"
  fetchpriority="high"
/>

<style>
  :global(picture:has(> .hero-pic)) {
    display: block;
  }
  :global(.hero-pic) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: calc(var(--pr-radius) * 1.5);
    border: 1px solid var(--pr-border);
    background: #0b1530;
    box-shadow: 0 10px 24px -14px rgb(15 18 32 / 0.4);
  }
  :global([data-theme='dark'] .hero-pic) {
    box-shadow: none;
  }
</style>
