---
// A dated list, oldest at the top, each entry linked to the report it comes
// from. Used on the threat page.
interface Props {
  items: { when: string; text: string; source: string; href: string }[];
}
const { items } = Astro.props;
---

<ol class="timeline not-prose">
  {items.map((i) => (
    <li>
      <span class="when">{i.when}</span>
      <span class="what">
        {i.text}{' '}
        <a href={i.href} target="_blank" rel="noopener noreferrer">{i.source}<span class="sr-only"> (opens in a new tab)</span></a>
      </span>
    </li>
  ))}
</ol>

<style>
  .timeline {
    position: relative;
    margin: 1.5rem 0 2rem !important;
    padding: 0 !important;
    list-style: none;
  }
  .timeline::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 0.35rem;
    width: 2px;
    background: var(--pr-border);
  }
  li {
    position: relative;
    display: grid;
    gap: 0.15rem;
    margin: 0 !important;
    padding: 0 0 1.25rem 1.75rem;
  }
  li::before {
    content: '';
    position: absolute;
    top: 0.45rem;
    left: 0;
    width: 0.8rem;
    height: 0.8rem;
    border: 2px solid var(--pr-accent);
    border-radius: 50%;
    background: var(--pr-bg);
  }
  .when {
    color: var(--pr-heading);
    font-size: var(--text-sm);
    font-weight: 650;
  }
  .what {
    font-size: 1rem;
  }
  .what a {
    color: var(--pr-muted);
    font-size: var(--text-sm);
  }
</style>
