---
// The trail above a page title, so a reader who arrived from a search knows
// which part of the site they are in. Home is always first.
interface Props {
  items: { label: string; href: string }[];
}
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const crumbs = [{ label: 'Home', href: `${base}/` }, ...Astro.props.items];
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {crumbs.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
  </ol>
</nav>

<style>
  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-xs);
  }
  li + li::before {
    content: '/';
    margin-inline: 0.5rem;
    color: var(--pr-muted);
  }
  a {
    color: var(--pr-muted);
    text-decoration: none;
  }
  a:hover {
    color: var(--pr-heading);
    text-decoration: underline;
  }
</style>
