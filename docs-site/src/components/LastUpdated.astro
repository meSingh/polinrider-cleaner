---
// Two dates for the landing page, both worked out when the site is built so
// neither can go stale by somebody forgetting to edit it:
//
// - the newest indicator review, from the file names of the review pages;
// - the last change to the repository, from the commit the site was built
//   from (the deploy checkout is shallow, which still has that one commit).
//   Outside a git checkout it falls back to the build date.
import { execSync } from 'node:child_process';

const reviews = Object.keys(import.meta.glob('../content/docs/indicator-reviews/*.md'))
  .map((path) => path.match(/(\d{4}-\d{2}-\d{2})\.md$/)?.[1])
  .filter((date): date is string => Boolean(date))
  .sort();
const reviewed = reviews.at(-1);

let updated: string;
try {
  updated = execSync('git log -1 --format=%cs', { encoding: 'utf8' }).trim();
} catch {
  updated = new Date().toISOString().slice(0, 10);
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const long = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
---

<p class="last-updated">
  <span>Last updated <time datetime={updated}>{long(updated)}</time></span>
  {
    reviewed && (
      <span>
        Indicators reviewed weekly, last on{' '}
        <a href={`${base}/indicator-reviews/${reviewed}/`}><time datetime={reviewed}>{long(reviewed)}</time></a>
      </span>
    )
  }
</p>

<style>
  .last-updated {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1.25rem;
    margin: -1rem 0 0;
    font-size: 0.875rem;
    color: var(--muted-foreground);
    text-align: center;
  }
  .last-updated span::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    vertical-align: 0.05rem;
  }
  .last-updated a {
    color: inherit;
  }
</style>
