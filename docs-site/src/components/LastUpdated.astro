---
// "Last updated" with how long ago. With no date, the date of the commit the
// site was built from (the deploy checkout is shallow, which still has that
// one commit), so the home page cannot go stale by somebody forgetting to
// edit it. A page passes its own date from git (src/git.ts).
import { lastUpdated } from '../git';
import { longDate } from '../releaseDate';

interface Props {
  date?: string;
  align?: 'center' | 'start';
}
const { date, align = 'center' } = Astro.props;
const updated = date ?? lastUpdated();
---

<p class:list={['last-updated', align]}>
  <span>Last updated: <time datetime={updated}>{longDate(updated)}</time><span class="ago" data-since={updated}></span></span>
</p>

<script>
  // How long ago, worked out in the reader's browser: the page is built once,
  // so a count baked in at build time would only ever say "today". Without
  // JavaScript the date alone is shown.
  for (const el of document.querySelectorAll<HTMLElement>('.last-updated .ago')) {
    const since = Date.parse(`${el.dataset.since}T00:00:00Z`);
    if (Number.isNaN(since)) continue;
    const now = new Date();
    const today = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate());
    const days = Math.max(0, Math.round((today - since) / 86_400_000));
    const words =
      days === 0 ? 'today'
      : days === 1 ? 'yesterday'
      : days < 60 ? `${days} days ago`
      : days < 730 ? `${Math.round(days / 30)} months ago`
      : `${Math.round(days / 365)} years ago`;
    el.textContent = ` (${words})`;
  }
</script>

<style>
  .last-updated {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1.25rem;
    margin: 0 0 2rem;
    font-size: 0.875rem;
    color: var(--pr-muted);
    text-align: center;
  }
  .last-updated.start {
    justify-content: flex-start;
    text-align: start;
  }
  .last-updated > span::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.45rem;
    border-radius: 50%;
    background: var(--pr-accent);
    box-shadow: 0 0 8px var(--pr-accent);
    vertical-align: 0.05rem;
  }
</style>
