{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs-site",
      "runtimeExecutable": "./ci/docs-serve.sh",
      "runtimeArgs": [
        "4321"
      ],
      "port": 4321
    },
    {
      "name": "docs-site-redesign",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--prefix",
        "docs-site",
        "--",
        "--port",
        "4323"
      ],
      "port": 4323,
      "autoPort": false
    },
    {
      "name": "docs-site-root",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "SITE_BASE=",
        "SITE_ORIGIN=https://polinrider.example",
        "npm",
        "run",
        "preview",
        "--prefix",
        "docs-site",
        "--",
        "--port",
        "4325"
      ],
      "port": 4325,
      "autoPort": false
    }
  ]
}
